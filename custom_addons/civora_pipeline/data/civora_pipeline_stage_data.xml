<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="stage_nouveau" model="civora.pipeline.stage">
        <field name="company_id" eval="False"/>
        <field name="name">Nouveau</field>
        <field name="code">nouveau</field>
        <field name="sequence">10</field>
    </record>
    <record id="stage_qualifie" model="civora.pipeline.stage">
        <field name="company_id" eval="False"/>
        <field name="name">Qualifié</field>
        <field name="code">qualifie</field>
        <field name="sequence">20</field>
    </record>
    <record id="stage_visite" model="civora.pipeline.stage">
        <field name="company_id" eval="False"/>
        <field name="name">Visite</field>
        <field name="code">visite</field>
        <field name="sequence">30</field>
    </record>
    <record id="stage_offre" model="civora.pipeline.stage">
        <field name="company_id" eval="False"/>
        <field name="name">Offre</field>
        <field name="code">offre</field>
        <field name="sequence">40</field>
    </record>
    <record id="stage_gagne" model="civora.pipeline.stage">
        <field name="company_id" eval="False"/>
        <field name="name">Gagné</field>
        <field name="code">gagne</field>
        <field name="sequence">50</field>
        <field name="is_won" eval="True"/>
    </record>
    <record id="stage_perdu" model="civora.pipeline.stage">
        <field name="company_id" eval="False"/>
        <field name="name">Perdu</field>
        <field name="code">perdu</field>
        <field name="sequence">60</field>
        <field name="is_lost" eval="True"/>
        <field name="fold" eval="True"/>
    </record>

</odoo>
