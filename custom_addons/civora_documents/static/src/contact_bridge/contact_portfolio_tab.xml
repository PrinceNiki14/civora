<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="civora_documents.ContactPortfolioTab">
    <div class="civora-portfolio">
        <div t-if="state.loading" class="civora-portfolio-loading">
            <i class="fa fa-circle-o-notch fa-spin"/> Chargement du portefeuille…
        </div>

        <div t-elif="!state.data" class="civora-portfolio-empty">
            <i class="fa fa-exclamation-triangle"/>
            <div class="civora-portfolio-empty-t">Impossible de charger le portefeuille</div>
            <p>Ouvrez la console (F12) pour voir le détail de l'erreur.</p>
        </div>

        <div t-elif="state.backendError" class="civora-portfolio-empty" style="text-align:left;">
            <div style="text-align:center;">
                <i class="fa fa-bug"/>
                <div class="civora-portfolio-empty-t">Erreur backend détectée</div>
            </div>
            <p style="margin-top:14px;"><b>Message :</b></p>
            <pre style="background:#f7f8fa;padding:10px;border-radius:8px;font-size:11px;overflow-x:auto;white-space:pre-wrap;" t-esc="state.backendError"/>
            <p t-if="state.backendTrace.length"><b>Trace (5 dernières lignes) :</b></p>
            <pre t-if="state.backendTrace.length" style="background:#f7f8fa;padding:10px;border-radius:8px;font-size:11px;overflow-x:auto;">
                <t t-foreach="state.backendTrace" t-as="l" t-key="l_index"><t t-esc="l"/><br/></t>
            </pre>
        </div>

        <t t-else="">
            <!-- KPIs -->
            <div class="civora-portfolio-kpis">
                <CivoraStatCard label="'Biens du portefeuille'"
                                value="totalBiens + ''"
                                delta="totalBiens ? 'total' : 'aucun bien'"
                                icon="'fa fa-building-o'"/>
                <CivoraStatCard label="'Biens loués'"
                                value="louesCount + ''"
                                delta="occupancyRate + ' d\'occupation'"
                                icon="'fa fa-key'"/>
                <CivoraStatCard label="'Loyer mensuel'"
                                value="fmtMoney(totalRent)"
                                delta="'théorique cumulé'"
                                icon="'fa fa-money'"/>
                <CivoraStatCard label="'Taux d\'occupation'"
                                value="occupancyRate"
                                delta="louesCount + ' / ' + totalBiens"
                                icon="'fa fa-percent'"/>
            </div>

            <!-- Toolbar : Groupement -->
            <div t-if="totalBiens" class="civora-portfolio-toolbar">
                <div class="civora-portfolio-title">Biens du portefeuille</div>
                <div class="civora-portfolio-groupby">
                    <label>Grouper :</label>
                    <select t-on-change="(ev) => this.onGroupByChange(ev)">
                        <option t-foreach="groupOptions" t-as="g" t-key="g.value"
                                t-att-value="g.value"
                                t-att-selected="state.groupBy === g.value"
                                t-esc="g.label"/>
                    </select>
                </div>
            </div>

            <!-- Empty -->
            <div t-if="!totalBiens" class="civora-portfolio-empty">
                <i class="fa fa-building-o"/>
                <div class="civora-portfolio-empty-t">Aucun bien en portefeuille</div>
                <p>Ce contact n'est propriétaire d'aucun bien actuellement.</p>
            </div>

            <!-- Mode plat -->
            <div t-if="state.groupBy === 'none' &amp;&amp; state.data.items.length"
                 class="civora-portfolio-grid">
                <t t-foreach="state.data.items" t-as="b" t-key="b.id">
                    <t t-call="civora_documents.PortfolioCard"><t t-set="bien" t-value="b"/></t>
                </t>
            </div>

            <!-- Mode groupé -->
            <div t-if="state.groupBy !== 'none' &amp;&amp; state.data.groups.length"
                 class="civora-portfolio-groups">
                <div t-foreach="state.data.groups" t-as="g" t-key="g.id"
                     class="civora-portfolio-group">
                    <div class="civora-portfolio-group-h" t-on-click="() => this.toggleGroup(g.id)">
                        <i t-att-class="'fa ' + (isExpanded(g.id) ? 'fa-chevron-down' : 'fa-chevron-right') + ' civora-portfolio-group-chev'"/>
                        <div class="civora-portfolio-group-name" t-esc="g.name"/>
                        <span class="civora-portfolio-group-count">
                            <t t-esc="g.count"/> bien<t t-if="g.count > 1">s</t>
                        </span>
                    </div>
                    <div t-if="isExpanded(g.id)" class="civora-portfolio-group-body">
                        <div class="civora-portfolio-grid">
                            <t t-foreach="g.items" t-as="b" t-key="b.id">
                                <t t-call="civora_documents.PortfolioCard"><t t-set="bien" t-value="b"/></t>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </div>
</t>

<!-- ================ Sub-template : carte d'un bien ================ -->
<t t-name="civora_documents.PortfolioCard">
    <div class="civora-portfolio-card" t-on-click="() => this.openProperty(bien.id)">
        <div class="civora-portfolio-card-h">
            <div class="civora-portfolio-card-ico">
                <i class="fa fa-building-o"/>
            </div>
            <div class="civora-portfolio-card-info">
                <div class="civora-portfolio-card-name" t-esc="bien.name"/>
                <div t-if="bien.ref || bien.city" class="civora-portfolio-card-sub">
                    <t t-if="bien.ref"><t t-esc="bien.ref"/></t>
                    <t t-if="bien.ref &amp;&amp; bien.city"> · </t>
                    <t t-if="bien.city"><t t-esc="bien.city"/></t>
                </div>
            </div>
            <CivoraBadge label="statusMeta(bien.status).label" variant="statusMeta(bien.status).variant"/>
        </div>

        <div class="civora-portfolio-card-body">
            <div t-if="bien.tenant_id" class="civora-portfolio-card-row civora-portfolio-card-row-clickable"
                 t-on-click="(ev) => this.openTenant(bien.tenant_id, ev)">
                <span class="civora-portfolio-card-label">
                    <i class="fa fa-user"/> Locataire
                </span>
                <span class="civora-portfolio-card-value civora-portfolio-card-link" t-esc="bien.tenant_name"/>
            </div>
            <div t-if="bien.monthly_rent" class="civora-portfolio-card-row">
                <span class="civora-portfolio-card-label">
                    <i class="fa fa-money"/> Loyer
                </span>
                <span class="civora-portfolio-card-value civora-portfolio-card-rent"
                      t-esc="fmtMoney(bien.monthly_rent) + ' / mois'"/>
            </div>
            <div t-if="bien.active_lease_ref" class="civora-portfolio-card-row">
                <span class="civora-portfolio-card-label">
                    <i class="fa fa-file-text-o"/> Bail
                </span>
                <span class="civora-portfolio-card-value" t-esc="bien.active_lease_ref"/>
            </div>
        </div>

        <div class="civora-portfolio-card-foot">
            <span class="civora-portfolio-card-open">Ouvrir la fiche <i class="fa fa-arrow-right"/></span>
        </div>
    </div>
</t>

</templates>
