<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_lease_receipt" model="ir.actions.report">
        <field name="name">Quittance de loyer</field>
        <field name="model">civora.lease.receipt</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">civora_locations.report_lease_receipt</field>
        <field name="report_file">civora_locations.report_lease_receipt</field>
        <field name="print_report_name">'Quittance - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_civora_lease_receipt"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="report_lease_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="doc.company_id or env.company"/>
                    <t t-set="owner" t-value="doc.owner_id"/>

                <style type="text/css">
                    .civora-receipt-body { font-family: Arial, Helvetica, sans-serif; color: #071123; }
                    .civora-receipt-body p { margin: 0 0 6px 0; font-size: 11pt; line-height: 1.55; }
                    .civora-receipt-body b, .civora-receipt-body strong { color: #071123; }
                    .civora-receipt-body .table-clean { border-collapse: collapse; width: 100%; }
                    .civora-receipt-body .table-clean td { border: none; }
                </style>

                <div class="page civora-receipt-body">

                    <div style="height:3px; line-height:0; font-size:0; background-color:#e6a23c; margin-bottom:14px;">&#160;</div>

                    <div style="text-align:center; margin-bottom:22px;">
                        <div style="font-size:22pt; font-weight:900; color:#091a36; letter-spacing:1.5px;">
                            QUITTANCE DE LOYER
                        </div>
                    </div>

                    <table class="table-clean" style="background-color:#f4f5f7; margin-bottom:22px;">
                        <tr>
                            <td style="padding:14px 18px; width:50%; vertical-align:top;">
                                <div style="font-size:10.5pt; color:#333; font-weight:bold; margin-bottom:6px;">
                                    N° Quittance :
                                    <span style="font-weight:normal; margin-left:6px;">
                                        <span t-field="doc.name"/>
                                    </span>
                                </div>
                                <div style="font-size:10.5pt; color:#333; font-weight:bold;">
                                    Période concernée :
                                    <span style="font-weight:normal; margin-left:6px;">
                                        <span t-field="doc.period_label"/>
                                    </span>
                                </div>
                            </td>
                            <td style="padding:14px 18px; vertical-align:top;">
                                <div style="font-size:10.5pt; color:#333; font-weight:bold;">
                                    Date d'émission :
                                    <span style="font-weight:normal; margin-left:6px;">
                                        <span t-field="doc.date_issued"/>
                                    </span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="table-clean" style="margin-bottom:22px;">
                        <tr>
                            <td style="width:48%; vertical-align:top; padding-right:8px;">
                                <div style="background-color:#1a2f52; padding:8px 14px;">
                                    <span style="color:#ffffff; font-size:9.5pt; font-weight:bold; letter-spacing:0.5px;">
                                        LE BAILLEUR
                                    </span>
                                </div>
                                <div style="border:1px solid #d0d5dd; border-top:none; padding:14px; min-height:130px;">
                                    <div style="font-size:11pt; font-weight:bold; color:#071123; margin-bottom:8px;">
                                        <span t-field="company.name"/>
                                    </div>
                                    <div style="font-size:9.5pt; color:#333; line-height:1.6;">
                                        <t t-if="company.street">
                                            <span t-field="company.street"/><t t-if="company.city">, </t>
                                        </t>
                                        <t t-if="company.city">
                                            <span t-field="company.city"/>
                                        </t>
                                    </div>
                                    <div style="margin-top:8px; font-size:9.5pt; color:#333; line-height:1.7;">
                                        <t t-if="company.phone">
                                            Tél : <span t-field="company.phone"/><br/>
                                        </t>
                                        <t t-if="company.email">
                                            Email : <span t-field="company.email"/><br/>
                                        </t>
                                        <t t-if="company.company_registry">
                                            <span t-field="company.company_registry"/>
                                        </t>
                                    </div>
                                </div>
                            </td>

                            <td style="width:4%;">&#160;</td>

                            <td style="width:48%; vertical-align:top;">
                                <div style="background-color:#e6a23c; padding:8px 14px;">
                                    <span style="color:#ffffff; font-size:9.5pt; font-weight:bold; letter-spacing:0.5px;">
                                        LE LOCATAIRE
                                    </span>
                                </div>
                                <div style="border:1px solid #d0d5dd; border-top:none; padding:14px; min-height:130px;">
                                    <div style="font-size:11pt; font-weight:bold; color:#071123; margin-bottom:8px;">
                                        <span t-field="doc.tenant_id.name"/>
                                    </div>
                                    <t t-if="doc.property_id">
                                        <div style="font-size:9.5pt; color:#333; margin-top:6px;">
                                            Bien occupé :
                                        </div>
                                        <div style="font-size:10pt; font-weight:bold; color:#071123; margin-top:2px;">
                                            <span t-field="doc.property_id.name"/>
                                        </div>
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div style="font-size:10.5pt; color:#333; line-height:1.7; margin-bottom:18px; text-align:justify;">
                        Je soussigné(e),
                        <t t-if="owner">
                            <b><span t-field="owner.name"/></b>,
                            propriétaire du bien
                        </t>
                        <t t-else="">
                            représentant(e) légal(e) de <b><span t-field="company.name"/></b>,
                        </t>
                        déclare avoir reçu de <b><span t-field="doc.tenant_id.name"/></b>,
                        locataire désigné ci-dessus, la somme indiquée ci-après au titre du
                        loyer et des charges pour la période de <b><span t-field="doc.period_label"/></b>.
                    </div>

                    <div style="margin-bottom:14px;">
                        <div style="font-size:12pt; font-weight:bold; color:#091a36; letter-spacing:0.5px;
                                    display:inline-block; border-bottom:2px solid #e6a23c; padding-bottom:2px;">
                            DÉTAIL DU PAIEMENT
                        </div>
                    </div>

                    <div style="border:1px solid #d0d5dd; padding:0; margin-bottom:22px;">
                        <table class="table-clean">
                            <tr>
                                <td style="padding:14px 20px; font-size:11pt; color:#333;">
                                    Loyer hors charges
                                </td>
                                <td style="padding:14px 20px; font-size:11pt; text-align:right; font-weight:bold; color:#071123;">
                                    <span t-field="doc.rent" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px 20px 14px 20px; font-size:11pt; color:#333;">
                                    Charges locatives
                                </td>
                                <td style="padding:6px 20px 14px 20px; font-size:11pt; text-align:right; font-weight:bold; color:#071123;">
                                    <span t-field="doc.charges" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="border-top:1px solid #d0d5dd; padding:0; line-height:0; font-size:0;">&#160;</td>
                            </tr>
                            <tr>
                                <td style="padding:14px 20px 4px 20px; font-size:13pt; font-weight:900; color:#091a36;">
                                    TOTAL ENCAISSÉ
                                </td>
                                <td style="padding:14px 20px 4px 20px; font-size:13pt; font-weight:900; text-align:right; color:#091a36;">
                                    <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="padding:0 20px 14px 20px; font-size:9.5pt; font-style:italic; color:#666;">
                                    Soit : <span t-field="doc.amount_words"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:12px 20px; font-size:10pt; color:#333; border-top:1px solid #e9ebef;">
                                    <t t-if="doc.date_paid">
                                        Date du paiement : <b><span t-field="doc.date_paid"/></b>
                                    </t>
                                </td>
                                <td style="padding:12px 20px; font-size:10pt; text-align:right; color:#333; border-top:1px solid #e9ebef;">
                                    <t t-if="doc.method">
                                        Mode :
                                        <b>
                                            <span t-esc="dict(doc._fields['method'].selection).get(doc.method)"/>
                                        </b>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="border:1px solid #7ec99a; background-color:#eaf7ef; padding:14px 20px; margin-bottom:18px; text-align:center;">
                        <div style="font-size:11pt; font-weight:bold; color:#1e6b3b; letter-spacing:0.8px; margin-bottom:8px;">
                            CERTIFICATION DU BAILLEUR
                        </div>
                        <div style="font-size:10pt; color:#1e6b3b; line-height:1.6;">
                            Le bailleur reconnaît avoir reçu du locataire la somme mentionnée ci-dessus pour la période indiquée.
                        </div>
                        <div style="font-size:10pt; color:#1e6b3b; line-height:1.6; margin-top:4px;">
                            Cette quittance annule et remplace tous les reçus précédents pour la même période.
                            Le locataire est libéré de toute obligation de paiement pour ladite période.
                        </div>
                    </div>

                    <div style="font-size:8.5pt; color:#666; font-style:italic; line-height:1.6; text-align:justify;">
                        Document établi conformément aux dispositions légales en vigueur.
                        La présente quittance fait foi du paiement du loyer pour la période concernée
                        et doit être conservée par le locataire.
                    </div>

                </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
