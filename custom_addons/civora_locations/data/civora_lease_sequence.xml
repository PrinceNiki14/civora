<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!--
        Sequence pour la numerotation automatique des baux.
        Format : BL-YYYY-000 (ex. BL-2026-001), reset annuel.
    -->
    <record id="seq_civora_lease" model="ir.sequence">
        <field name="name">Numérotation des baux CIVORA</field>
        <field name="code">civora.lease</field>
        <field name="prefix">BL-%(year)s-</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="use_date_range" eval="True"/>
    </record>

    <!-- Numerotation des quittances : QIT-YYYY-000 -->
    <record id="seq_civora_lease_receipt" model="ir.sequence">
        <field name="name">Numérotation des quittances CIVORA</field>
        <field name="code">civora.lease.receipt</field>
        <field name="prefix">QIT-%(year)s-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="use_date_range" eval="True"/>
    </record>

    <!-- Numerotation des restitutions de caution : RC-YYYY-000 -->
    <record id="seq_civora_deposit_refund" model="ir.sequence">
        <field name="name">Numérotation des restitutions de caution CIVORA</field>
        <field name="code">civora.deposit.refund</field>
        <field name="prefix">RC-%(year)s-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="use_date_range" eval="True"/>
    </record>

    <!-- Numerotation des relances : REL-YYYY-000 -->
    <record id="seq_civora_lease_reminder" model="ir.sequence">
        <field name="name">Numérotation des relances CIVORA</field>
        <field name="code">civora.lease.reminder</field>
        <field name="prefix">REL-%(year)s-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="use_date_range" eval="True"/>
    </record>

</odoo>
