<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ecran Locations CIVORA (client action OWL, aucune vue Odoo) -->
    <record id="action_civora_leases" model="ir.actions.client">
        <field name="name">Locations</field>
        <field name="tag">civora.leases</field>
    </record>

    <!-- Ecran Paramétrage des clauses de bail -->
    <record id="action_civora_clauses" model="ir.actions.client">
        <field name="name">Paramétrage contrats</field>
        <field name="tag">civora.clauses</field>
    </record>

    <!-- Rattache l'ecran Locations au menu existant -->
    <menuitem id="civora_agence.menu_locations" action="action_civora_leases"/>

    <!-- Sous-menu Paramétrage dans Locations -->
    <menuitem id="menu_civora_locations_config"
              name="Paramétrage contrats"
              parent="civora_agence.menu_locations"
              action="action_civora_clauses"
              sequence="50"/>

</odoo>
