<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_workflows.WorkflowDrawer">
    <CivoraDrawer title="'Nouveau workflow'" icon="'fa-random'" onClose="props.onClose">
        <t t-set-slot="default">
            <div class="civora-drawer-form">
                <!-- Modele -->
                <div class="civora-form-section">
                    <h3>Modele</h3>
                    <div class="civora-form-row">
                        <div class="civora-form-group" style="flex:1">
                            <label>A partir d'un modele</label>
                            <select t-on-change="onTemplateChange" class="civora-input">
                                <option value="">-- Sans modele --</option>
                                <t t-foreach="templates.list" t-as="t" t-key="t.id">
                                    <option t-att-value="t.id"><t t-esc="t.name"/> (<t t-esc="t.step_count"/> etapes)</option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Informations -->
                <div class="civora-form-section">
                    <h3>Informations</h3>
                    <div class="civora-form-row">
                        <div class="civora-form-group" style="flex:1">
                            <label>Titre *</label>
                            <input type="text" class="civora-input" t-att-value="form.title"
                                   t-on-input="(ev) => this.form.title = ev.target.value"
                                   placeholder="Ex: Vente Villa Cocody..."/>
                        </div>
                    </div>
                    <div class="civora-form-row">
                        <div class="civora-form-group">
                            <label>Categorie</label>
                            <select class="civora-input" t-att-value="form.category"
                                    t-on-change="(ev) => this.form.category = ev.target.value">
                                <option value="vente">Vente</option>
                                <option value="location">Location</option>
                                <option value="gestion">Gestion</option>
                                <option value="administratif">Administratif</option>
                            </select>
                        </div>
                        <div class="civora-form-group">
                            <label>Priorite</label>
                            <select class="civora-input" t-att-value="form.priority"
                                    t-on-change="(ev) => this.form.priority = ev.target.value">
                                <option value="normal">Normal</option>
                                <option value="urgent">Urgent</option>
                                <option value="critique">Critique</option>
                            </select>
                        </div>
                    </div>
                    <div class="civora-form-row">
                        <div class="civora-form-group">
                            <label>Echeance</label>
                            <input type="date" class="civora-input" t-att-value="form.deadline"
                                   t-on-input="(ev) => this.form.deadline = ev.target.value"/>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="civora-form-section">
                    <h3>Notes</h3>
                    <div class="civora-form-row">
                        <div class="civora-form-group" style="flex:1">
                            <textarea class="civora-input" rows="3" t-att-value="form.notes"
                                      t-on-input="(ev) => this.form.notes = ev.target.value"
                                      placeholder="Contexte, instructions..."/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <t t-set-slot="footer">
            <button class="civora-btn civora-btn-accent" t-on-click="save">Creer le workflow</button>
        </t>
    </CivoraDrawer>
</t>
</templates>
