<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_workflows.WorkflowDrawer">
    <CivoraDrawer title="drawerTitle" icon="'fa-random'" onClose="props.onClose">
        <t t-set-slot="default">
            <div class="civora-drawer-form">
                <div class="civora-form-section">
                    <h3>Informations</h3>
                    <div class="civora-form-row">
                        <div class="civora-form-group" style="flex:1">
                            <label>Nom *</label>
                            <input type="text" class="civora-input" t-att-value="form.name"
                                   t-on-input="(ev) => this.form.name = ev.target.value"
                                   placeholder="Ex: Relance impayes J+5..."/>
                        </div>
                    </div>
                    <div class="civora-form-row">
                        <div class="civora-form-group">
                            <label>Categorie</label>
                            <select class="civora-input" t-att-value="form.category"
                                    t-on-change="(ev) => this.form.category = ev.target.value">
                                <option value="vente">Vente</option>
                                <option value="location">Location</option>
                                <option value="gestion">Gestion</option>
                                <option value="administratif">Administratif</option>
                            </select>
                        </div>
                        <div class="civora-form-group">
                            <label>Type de declencheur</label>
                            <select class="civora-input" t-att-value="form.trigger_type"
                                    t-on-change="(ev) => this.form.trigger_type = ev.target.value">
                                <option value="event">Evenement</option>
                                <option value="schedule">Planifie</option>
                                <option value="condition">Condition IA</option>
                                <option value="manual">Manuel</option>
                            </select>
                        </div>
                    </div>
                    <div class="civora-form-row">
                        <div class="civora-form-group" style="flex:1">
                            <label>Declencheur</label>
                            <input type="text" class="civora-input" t-att-value="form.trigger_description"
                                   t-on-input="(ev) => this.form.trigger_description = ev.target.value"
                                   placeholder="Ex: Loyer non percu, Bail signe..."/>
                        </div>
                    </div>
                </div>

                <div class="civora-form-section">
                    <h3>Description</h3>
                    <div class="civora-form-row">
                        <div class="civora-form-group" style="flex:1">
                            <textarea class="civora-input" rows="3" t-att-value="form.description"
                                      t-on-input="(ev) => this.form.description = ev.target.value"
                                      placeholder="Description du workflow..."/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <t t-set-slot="footer">
            <button class="civora-btn civora-btn-accent" t-on-click="save">
                <t t-if="isEdit">Enregistrer</t>
                <t t-else="">Creer l'automatisation</t>
            </button>
        </t>
    </CivoraDrawer>
</t>
</templates>
