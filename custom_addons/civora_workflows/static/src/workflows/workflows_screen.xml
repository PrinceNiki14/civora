<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_workflows.WorkflowsScreen">
    <div class="civora-workflows-screen">

        <!-- ============ HEADER ============ -->
        <div class="civora-screen-header">
            <div class="civora-screen-title">
                <h1>Workflows &amp; Automatisations</h1>
                <span class="civora-screen-subtitle" t-esc="subtitle"/>
            </div>
            <div class="civora-screen-actions">
                <button class="civora-btn civora-btn-outline" t-on-click="openTemplates">
                    <i class="fa fa-th-large"/> Templates
                </button>
                <button class="civora-btn civora-btn-accent" t-on-click="() => this.openBuilder(false)">
                    <i class="fa fa-plus"/> Nouveau workflow
                </button>
            </div>
        </div>

        <t t-if="state.loadError">
            <div class="civora-wfb-error"><i class="fa fa-exclamation-triangle"/> <t t-esc="state.loadError"/></div>
        </t>

        <!-- ============ KPIs ============ -->
        <div class="civora-kpi-grid">
            <CivoraStatCard
                label="'WORKFLOWS ACTIFS'"
                value="'' + (state.kpis.active_count or 0)"
                hint="(state.kpis.total_count or 0) + ' au total'"
                icon="'fa fa-bolt'"
                trend="'up'"/>
            <CivoraStatCard
                label="'EXÉCUTIONS'"
                value="fmtNum(state.kpis.runs)"
                hint="'cumulées'"
                icon="'fa fa-play-circle'"
                trend="'up'"/>
            <CivoraStatCard
                label="'TEMPS ÉCONOMISÉ'"
                value="(state.kpis.time_saved_hours or 0) + 'h'"
                hint="'estimation'"
                icon="'fa fa-clock-o'"
                trend="'up'"/>
            <CivoraStatCard
                label="'TAUX DE SUCCÈS'"
                value="(state.kpis.success_rate or 0) + '%'"
                hint="'moyenne'"
                icon="'fa fa-check-circle'"
                trend="'up'"/>
        </div>

        <!-- ============ IA INSIGHT + TOP AUTOMATION ============ -->
        <div class="civora-wf-middle">
            <div class="civora-insight">
                <div class="civora-insight-row">
                    <div class="civora-insight-spark"><i class="fa fa-magic"/></div>
                    <div class="civora-insight-main">
                        <div class="civora-insight-tag">IA · INSIGHT</div>
                        <div class="civora-insight-title" t-esc="state.insight.title or ''"/>
                        <p class="civora-insight-body" t-esc="state.insight.description or ''"/>
                        <div class="civora-insight-action">
                            <button class="civora-btn civora-btn-accent" t-on-click="openSuggestions">
                                <i class="fa fa-magic"/> Voir suggestions
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="civora-wf-top-card">
                <div class="civora-wf-top-label">TOP AUTOMATION</div>
                <div class="civora-wf-top-name" t-esc="state.top.title or '—'"/>
                <div class="civora-wf-top-stats">
                    <t t-esc="fmtNum(state.top.run_count)"/> exécutions · <t t-esc="state.top.success_rate or 0"/>% de succès
                </div>
                <div class="civora-wf-top-last">
                    Dernière exécution : <t t-esc="state.top.last_run or '—'"/>
                </div>
                <div class="civora-wf-top-action">
                    <button class="civora-btn civora-btn-outline" t-att-disabled="!state.top.id"
                            t-on-click="examineTop">Examiner</button>
                </div>
            </div>
        </div>

        <!-- ============ LISTE ============ -->
        <div class="civora-wf-section">
            <div class="civora-wf-section-header">
                <h2 class="civora-wf-section-title">Workflows</h2>
                <div class="civora-wf-filters">
                    <div class="civora-wf-search">
                        <i class="fa fa-search"/>
                        <input type="text" placeholder="Rechercher..."
                               t-att-value="state.search"
                               t-on-input="onSearch"/>
                    </div>
                    <select class="civora-wf-select" t-on-change="onStatus">
                        <option value="all" t-att-selected="isStatusFilter('all')">Tous statuts</option>
                        <option value="actif" t-att-selected="isStatusFilter('actif')">Actif</option>
                        <option value="pause" t-att-selected="isStatusFilter('pause')">Pause</option>
                        <option value="brouillon" t-att-selected="isStatusFilter('brouillon')">Brouillon</option>
                    </select>
                    <select class="civora-wf-select" t-on-change="onCategory">
                        <option value="all" t-att-selected="isCategoryFilter('all')">Toutes catégories</option>
                        <t t-foreach="categories" t-as="cat" t-key="cat.value">
                            <option t-att-value="cat.value" t-att-selected="isCategoryFilter(cat.value)" t-esc="cat.label"/>
                        </t>
                    </select>
                </div>
            </div>

            <div class="civora-wf-list">
                <t t-foreach="filtered" t-as="w" t-key="w.id">
                    <div class="civora-wf-card">
                        <div class="civora-wf-card-icon"><i class="fa fa-sitemap"/></div>
                        <div class="civora-wf-card-content">
                            <div class="civora-wf-card-title" t-esc="w.title"/>
                            <div class="civora-wf-card-meta">
                                Déclencheur : <t t-esc="w.trigger_description or '—'"/> · <t t-esc="w.step_count"/> étapes · <t t-esc="w.category_label"/>
                            </div>
                        </div>
                        <div class="civora-wf-card-right">
                            <span class="civora-wf-card-stats">
                                <t t-esc="fmtNum(w.run_count)"/> exécutions
                            </span>
                            <span t-att-class="statusClass(w.status)" t-esc="w.status_label"/>
                            <div class="civora-wf-card-actions">
                                <button class="civora-wf-icon-btn" t-att-title="toggleTitle(w)"
                                        t-on-click="() => this.toggleStatus(w)">
                                    <i t-attf-class="fa {{ toggleIcon(w) }}"/>
                                </button>
                                <button class="civora-wf-icon-btn" title="Tester le workflow"
                                        t-on-click="() => this.openTest(w)">
                                    <i class="fa fa-flask"/>
                                </button>
                                <button class="civora-wf-icon-btn" title="Modifier"
                                        t-on-click="() => this.openBuilder(w.id)">
                                    <i class="fa fa-pencil"/>
                                </button>
                                <button class="civora-wf-icon-btn civora-wf-icon-danger" title="Supprimer"
                                        t-on-click="() => this.askDelete(w)">
                                    <i class="fa fa-trash-o"/>
                                </button>
                                <button class="civora-wf-voir-btn" t-on-click="() => this.openView(w.id)">
                                    <i class="fa fa-eye"/> Voir
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-if="!filtered.length">
                    <div class="civora-wf-empty">
                        <t t-if="state.workflows.length">Aucun workflow ne correspond à ces filtres.</t>
                        <t t-else="">Aucun workflow configuré. Partez d'un modèle via « Templates ».</t>
                    </div>
                </t>
            </div>
        </div>

        <!-- ============ APERCU DU BUILDER ============ -->
        <t t-if="previewWorkflow">
            <div class="civora-wf-builder">
                <div class="civora-wf-builder-header">
                    <h3>Aperçu du builder · <t t-esc="previewWorkflow.title"/></h3>
                    <span>Déclencheur, délais, branches conditionnelles et actions IA</span>
                </div>
                <div class="civora-wf-builder-pipeline">
                    <t t-foreach="previewWorkflow.steps" t-as="s" t-key="s.id">
                        <t t-if="s_index &gt; 0">
                            <div class="civora-wf-builder-arrow"><i class="fa fa-long-arrow-right"/></div>
                        </t>
                        <div t-attf-class="civora-wf-builder-node civora-wf-node--{{ s.kind }}">
                            <div class="civora-wf-node-icon"><i t-attf-class="fa {{ s.icon }}"/></div>
                            <div class="civora-wf-node-label" t-esc="s.kind_label"/>
                            <div class="civora-wf-node-name" t-esc="s.name"/>
                            <div class="civora-wf-node-desc" t-esc="s.detail"/>
                        </div>
                    </t>
                </div>
            </div>
        </t>

        <!-- ============ MODALES ============ -->
        <t t-if="state.builderOpen">
            <WorkflowBuilderDialog
                workflowId="state.builderId"
                preset="state.builderPreset"
                onSaved.bind="onBuilderSaved"
                onClose.bind="closeBuilder"/>
        </t>
        <t t-if="state.templatesOpen">
            <WorkflowTemplatesDialog
                templates="state.templates"
                highlightIds="state.insight.template_ids or []"
                onUse.bind="useTemplate"
                onCustomize.bind="customizeTemplate"
                onClose.bind="closeTemplates"/>
        </t>
        <t t-if="viewWorkflow">
            <WorkflowViewDialog
                workflow="viewWorkflow"
                onOpenFull.bind="openFull"
                onClose.bind="closeView"/>
        </t>
        <t t-if="state.testId">
            <WorkflowTestDialog
                workflowId="state.testId"
                title="state.testTitle"
                onDone.bind="onTestDone"
                onClose.bind="closeTest"/>
        </t>

        <!-- Confirmation de suppression -->
        <t t-if="deleteWorkflow">
            <div class="civora-drawer-overlay" t-on-click="cancelDelete"/>
            <div class="civora-drawer civora-drawer--modal civora-drawer--sm civora-wf-confirm">
                <div class="civora-drawer-head">
                    <div class="civora-drawer-head-txt">
                        <div class="civora-drawer-ico civora-drawer-ico--danger"><i class="fa fa-trash-o"/></div>
                        <div class="civora-drawer-head-labels">
                            <div class="civora-drawer-title">Supprimer le workflow</div>
                            <div class="civora-drawer-sub">Cette action est définitive.</div>
                        </div>
                    </div>
                    <button class="civora-drawer-close" t-on-click="cancelDelete"><i class="fa fa-times"/></button>
                </div>
                <div class="civora-drawer-body">
                    <p>
                        Le workflow <strong t-esc="deleteWorkflow.title"/> et son historique
                        (<t t-esc="deleteWorkflow.run_count"/> exécutions) seront supprimés.
                    </p>
                </div>
                <div class="civora-drawer-foot">
                    <button class="civora-btn civora-btn-ghost" t-on-click="cancelDelete">Annuler</button>
                    <button class="civora-btn civora-btn-danger" t-on-click="confirmDelete">
                        <i class="fa fa-trash-o"/> Supprimer
                    </button>
                </div>
            </div>
        </t>
    </div>
</t>
</templates>
