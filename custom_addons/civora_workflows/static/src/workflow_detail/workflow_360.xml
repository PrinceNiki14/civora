<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_workflows.Workflow360">
    <div class="civora-workflow-360">
        <t t-if="state.workflow">
            <t t-set="wf" t-value="state.workflow"/>

            <!-- Topbar -->
            <div class="civora-360-topbar">
                <button class="civora-back-btn" t-on-click="goBack">
                    <i class="fa fa-arrow-left"/> Retour aux workflows
                </button>
            </div>

            <!-- Header -->
            <div class="civora-360-header">
                <div class="civora-360-info">
                    <h2><t t-esc="wf.name"/> — <t t-esc="wf.title"/></h2>
                    <div class="civora-360-meta">
                        <span t-attf-class="civora-status-badge civora-status-{{ stateClass(wf.state) }}">
                            <t t-esc="stateLabel(wf.state)"/>
                        </span>
                        <span t-attf-class="civora-priority-badge civora-priority-{{ priorityClass(wf.priority) }}">
                            <t t-esc="priorityLabel(wf.priority)"/>
                        </span>
                        <span t-if="wf.template_id"><i class="fa fa-sitemap"/> <t t-esc="wf.template_id[1]"/></span>
                        <span><i class="fa fa-tag"/> <t t-esc="categoryLabel(wf.category)"/></span>
                        <span t-if="wf.assigned_to"><i class="fa fa-user"/> <t t-esc="wf.assigned_to[1]"/></span>
                    </div>
                </div>
                <div class="civora-360-actions">
                    <t t-if="wf.state === 'brouillon'">
                        <button class="civora-btn civora-btn-accent" t-on-click="() => this.doAction('action_start')">Demarrer</button>
                    </t>
                    <t t-if="wf.state === 'en_cours'">
                        <button class="civora-btn civora-btn-outline" t-on-click="() => this.doAction('action_pause')">Mettre en pause</button>
                        <button class="civora-btn civora-btn-success" t-on-click="() => this.doAction('action_complete')">Terminer</button>
                    </t>
                    <t t-if="wf.state === 'en_pause'">
                        <button class="civora-btn civora-btn-accent" t-on-click="() => this.doAction('action_resume')">Reprendre</button>
                    </t>
                    <t t-if="wf.state !== 'termine' and wf.state !== 'annule'">
                        <button class="civora-btn civora-btn-danger" t-on-click="() => this.doAction('action_cancel')">Annuler</button>
                    </t>
                    <t t-if="wf.state === 'annule' or wf.state === 'termine'">
                        <button class="civora-btn civora-btn-outline" t-on-click="() => this.doAction('action_reset')">Reinitialiser</button>
                    </t>
                </div>
            </div>

            <!-- KPIs -->
            <div class="civora-360-kpis">
                <CivoraStatCard label="'Progression'" value="progressPercent() + '%'" icon="'fa-tasks'"/>
                <CivoraStatCard label="'Etapes'" value="(wf.completed_steps || 0) + ' / ' + (wf.step_count || 0)" icon="'fa-list-ol'"/>
                <CivoraStatCard label="'Debut'" value="wf.start_date || 'Non demarre'" icon="'fa-calendar'"/>
                <CivoraStatCard label="'Echeance'" value="wf.deadline || '—'" icon="'fa-clock-o'"/>
            </div>

            <!-- Progress bar -->
            <div class="civora-wf-progress-wrapper">
                <div class="civora-wf-progress-bar">
                    <div class="civora-wf-progress-fill" t-attf-style="width: {{ progressPercent() }}%"/>
                </div>
                <span class="civora-wf-progress-label"><t t-esc="progressPercent()"/>% complete</span>
            </div>

            <!-- Tabs -->
            <div class="civora-360-tabs">
                <button t-attf-class="civora-tab {{ state.activeTab === 'steps' ? 'active' : '' }}"
                        t-on-click="() => this.setTab('steps')">
                    Etapes
                    <span class="civora-tab-count" t-if="state.steps.length > 0"><t t-esc="state.steps.length"/></span>
                </button>
                <button t-attf-class="civora-tab {{ state.activeTab === 'details' ? 'active' : '' }}"
                        t-on-click="() => this.setTab('details')">Details</button>
            </div>

            <!-- Tab: Steps -->
            <t t-if="state.activeTab === 'steps'">
                <div class="civora-steps-list">
                    <t t-foreach="state.steps" t-as="step" t-key="step.id">
                        <div t-attf-class="civora-step-card civora-step-{{ stepClass(step.state) }}">
                            <div class="civora-step-header">
                                <div class="civora-step-left">
                                    <i t-attf-class="fa {{ stepIcon(step.state) }} civora-step-icon"/>
                                    <div>
                                        <div class="civora-step-name">
                                            <t t-esc="step.name"/>
                                            <span class="civora-step-required" t-if="step.is_required">obligatoire</span>
                                        </div>
                                        <div class="civora-step-meta">
                                            <span t-if="step.responsible_role" class="civora-step-role">
                                                <i class="fa fa-user-circle-o"/> <t t-esc="roleLabel(step.responsible_role)"/>
                                            </span>
                                            <span t-if="step.deadline">
                                                <i class="fa fa-calendar"/> <t t-esc="step.deadline"/>
                                            </span>
                                            <span t-if="step.completed_date" class="civora-step-done-date">
                                                <i class="fa fa-check"/> <t t-esc="step.completed_date"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="civora-step-right">
                                    <span t-attf-class="civora-status-badge civora-status-{{ stepClass(step.state) }}">
                                        <t t-esc="stepLabel(step.state)"/>
                                    </span>
                                </div>
                            </div>
                            <t t-if="step.description or step.notes">
                                <div class="civora-step-body">
                                    <p t-if="step.description"><t t-esc="step.description"/></p>
                                    <p t-if="step.notes" class="civora-step-notes"><i class="fa fa-sticky-note-o"/> <t t-esc="step.notes"/></p>
                                </div>
                            </t>
                            <div class="civora-step-actions">
                                <t t-if="step.state === 'a_faire'">
                                    <button class="civora-btn-sm civora-btn-info" t-on-click="() => this.stepAction(step.id, 'action_start')">Demarrer</button>
                                </t>
                                <t t-if="step.state === 'en_cours'">
                                    <button class="civora-btn-sm civora-btn-success" t-on-click="() => this.stepAction(step.id, 'action_complete')">Terminer</button>
                                    <button class="civora-btn-sm civora-btn-danger" t-on-click="() => this.stepAction(step.id, 'action_block')">Bloquer</button>
                                </t>
                                <t t-if="step.state === 'bloque'">
                                    <button class="civora-btn-sm civora-btn-info" t-on-click="() => this.stepAction(step.id, 'action_start')">Debloquer</button>
                                </t>
                                <t t-if="step.state === 'termine'">
                                    <button class="civora-btn-sm civora-btn-muted" t-on-click="() => this.stepAction(step.id, 'action_reset')">Rouvrir</button>
                                </t>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.steps.length === 0">
                        <div class="civora-empty-state">Aucune etape dans ce workflow</div>
                    </t>
                </div>
            </t>

            <!-- Tab: Details -->
            <t t-if="state.activeTab === 'details'">
                <div class="civora-360-grid">
                    <div class="civora-360-card">
                        <h3>Informations</h3>
                        <div class="civora-kv">
                            <span class="civora-k">Modele</span>
                            <span class="civora-v"><t t-esc="wf.template_id ? wf.template_id[1] : '—'"/></span>
                        </div>
                        <div class="civora-kv">
                            <span class="civora-k">Categorie</span>
                            <span class="civora-v"><t t-esc="categoryLabel(wf.category)"/></span>
                        </div>
                        <div class="civora-kv">
                            <span class="civora-k">Priorite</span>
                            <span class="civora-v"><t t-esc="priorityLabel(wf.priority)"/></span>
                        </div>
                        <div class="civora-kv">
                            <span class="civora-k">Responsable</span>
                            <span class="civora-v"><t t-esc="wf.assigned_to ? wf.assigned_to[1] : '—'"/></span>
                        </div>
                    </div>
                    <div class="civora-360-card">
                        <h3>Dates</h3>
                        <div class="civora-kv">
                            <span class="civora-k">Date de debut</span>
                            <span class="civora-v"><t t-esc="wf.start_date || '—'"/></span>
                        </div>
                        <div class="civora-kv">
                            <span class="civora-k">Echeance</span>
                            <span class="civora-v"><t t-esc="wf.deadline || '—'"/></span>
                        </div>
                        <div class="civora-kv">
                            <span class="civora-k">Date de fin</span>
                            <span class="civora-v"><t t-esc="wf.completed_date || '—'"/></span>
                        </div>
                        <div class="civora-kv" t-if="wf.reference">
                            <span class="civora-k">Reference</span>
                            <span class="civora-v"><t t-esc="wf.reference"/></span>
                        </div>
                    </div>
                </div>
                <t t-if="wf.notes">
                    <div class="civora-360-card" style="margin-top: 1.25rem;">
                        <h3>Notes</h3>
                        <p style="font-size: 0.85rem; color: #626a75; margin: 0;"><t t-esc="wf.notes"/></p>
                    </div>
                </t>
            </t>

        </t>
        <t t-else="">
            <div style="text-align: center; padding: 4rem; color: #626a75;">Chargement...</div>
        </t>
    </div>
</t>
</templates>
