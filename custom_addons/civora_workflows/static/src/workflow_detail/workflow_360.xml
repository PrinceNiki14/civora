<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_workflows.Workflow360">
    <div class="civora-wf360">
        <t t-if="state.loading">
            <div class="civora-wf360-loading">Chargement…</div>
        </t>
        <t t-elif="!state.wf">
            <div class="civora-wf360-loading">
                Workflow introuvable.
                <button class="civora-btn civora-btn-outline" t-on-click="goBack">Retour aux workflows</button>
            </div>
        </t>
        <t t-else="">
            <!-- ===== HEADER ===== -->
            <div class="civora-wf360-back">
                <button class="civora-wf360-backbtn" t-on-click="goBack">
                    <i class="fa fa-arrow-left"/> Workflows
                </button>
            </div>

            <div class="civora-wf360-header">
                <div class="civora-wf360-headmain">
                    <div class="civora-wf360-titlerow">
                        <h1 t-esc="w.title"/>
                        <span t-attf-class="civora-wf-badge civora-wf-badge-{{ w.status }}" t-esc="w.status_label"/>
                    </div>
                    <div class="civora-wf360-sub">
                        <span class="civora-wf360-ref" t-esc="w.ref"/>
                        · Déclencheur : <t t-esc="w.trigger_description or '—'"/>
                        · <t t-esc="w.category_label"/>
                        <t t-if="w.template_name"> · modèle « <t t-esc="w.template_name"/> »</t>
                    </div>
                    <p class="civora-wf360-desc" t-esc="w.description"/>
                </div>
                <div class="civora-wf360-headactions">
                    <button class="civora-btn civora-btn-outline" t-on-click="toggleStatus">
                        <i t-attf-class="fa {{ w.status === 'actif' ? 'fa-pause' : 'fa-play' }}"/>
                        <t t-if="w.status === 'actif'"> Mettre en pause</t>
                        <t t-else=""> Activer</t>
                    </button>
                    <button class="civora-btn civora-btn-outline" t-on-click="openTest">
                        <i class="fa fa-flask"/> Tester
                    </button>
                    <button class="civora-btn civora-btn-outline" t-on-click="duplicate">
                        <i class="fa fa-clone"/> Dupliquer
                    </button>
                    <button class="civora-btn civora-btn-accent" t-on-click="openBuilder">
                        <i class="fa fa-pencil"/> Modifier
                    </button>
                    <button class="civora-btn civora-btn-danger" t-on-click="askDelete">
                        <i class="fa fa-trash-o"/>
                    </button>
                </div>
            </div>

            <!-- ===== KPIs ===== -->
            <div class="civora-kpi-grid">
                <CivoraStatCard label="'EXÉCUTIONS'" value="fmtNum(w.run_count)"
                                hint="'depuis la mise en service'" icon="'fa fa-play-circle'" trend="'up'"/>
                <CivoraStatCard label="'TAUX DE SUCCÈS'" value="(w.success_rate or 0) + '%'"
                                hint="w.success_count + ' succès · ' + w.error_count + ' échecs'"
                                icon="'fa fa-check-circle'" trend="'up'"/>
                <CivoraStatCard label="'ÉTAPES'" value="'' + (w.step_count or 0)"
                                hint="w.trigger_type_label" icon="'fa fa-sitemap'" trend="'up'"/>
                <CivoraStatCard label="'TEMPS GAGNÉ'" value="(w.time_saved_hours or 0) + 'h'"
                                hint="'estimation'" icon="'fa fa-clock-o'" trend="'up'"/>
            </div>

            <!-- ===== TABS ===== -->
            <div class="civora-wf360-tabs">
                <button t-attf-class="civora-wf360-tab {{ isTab('steps') ? 'is-active' : '' }}"
                        t-on-click="() => this.setTab('steps')">Graphe d'exécution</button>
                <button t-attf-class="civora-wf360-tab {{ isTab('history') ? 'is-active' : '' }}"
                        t-on-click="() => this.setTab('history')">
                    Journal (<t t-esc="state.history.length"/>)
                </button>
                <button t-attf-class="civora-wf360-tab {{ isTab('settings') ? 'is-active' : '' }}"
                        t-on-click="() => this.setTab('settings')">Paramètres</button>
            </div>

            <!-- ===== GRAPHE ===== -->
            <t t-if="isTab('steps')">
                <div class="civora-wf360-panel">
                    <div class="civora-wf360-flow">
                        <t t-foreach="w.steps" t-as="s" t-key="s.id">
                            <div t-attf-class="civora-wf360-node civora-wf-node--{{ s.kind }}">
                                <div class="civora-wf360-nodenum" t-esc="s_index + 1"/>
                                <div class="civora-wf360-nodeico"><i t-attf-class="fa {{ s.icon }}"/></div>
                                <div class="civora-wf360-nodebody">
                                    <span t-attf-class="civora-wf-kind civora-wf-kind--{{ s.kind }}" t-esc="s.kind_label"/>
                                    <div class="civora-wf360-nodename" t-esc="s.name"/>
                                    <div t-if="s.detail" class="civora-wf360-nodedetail" t-esc="s.detail"/>
                                </div>
                            </div>
                            <t t-if="s_index &lt; w.steps.length - 1">
                                <div class="civora-wf360-link"><i class="fa fa-long-arrow-down"/></div>
                            </t>
                        </t>
                        <t t-if="!w.steps.length">
                            <div class="civora-wf360-empty">
                                Ce workflow n'a aucune étape. Cliquez sur « Modifier » pour construire son graphe.
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- ===== JOURNAL ===== -->
            <t t-if="isTab('history')">
                <div class="civora-wf360-panel">
                    <table class="civora-wf360-table">
                        <thead>
                            <tr>
                                <th>Résultat</th>
                                <th>Message</th>
                                <th>Étapes</th>
                                <th>Déclenché par</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.history" t-as="h" t-key="h.id">
                                <tr>
                                    <td>
                                        <span t-attf-class="civora-wf360-res civora-wview-run--{{ resultClass(h.result) }}">
                                            <i t-attf-class="fa {{ resultIcon(h.result) }}"/> <t t-esc="h.result_label"/>
                                        </span>
                                    </td>
                                    <td>
                                        <t t-esc="h.message"/>
                                        <span t-if="h.is_test" class="civora-wview-runtest">test</span>
                                    </td>
                                    <td t-esc="h.steps_done or '—'"/>
                                    <td t-esc="h.user or '—'"/>
                                    <td>
                                        <t t-esc="h.date_label"/>
                                        <span class="civora-wf360-ago" t-esc="h.ago"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="!state.history.length">
                                <tr><td colspan="5" class="civora-wf360-empty">
                                    Aucune exécution enregistrée. Utilisez « Tester » pour simuler une exécution.
                                </td></tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>

            <!-- ===== PARAMETRES ===== -->
            <t t-if="isTab('settings')">
                <div class="civora-wf360-panel">
                    <dl class="civora-wf360-deflist">
                        <div><dt>Référence</dt><dd t-esc="w.ref"/></div>
                        <div><dt>Catégorie</dt><dd t-esc="w.category_label"/></div>
                        <div><dt>Déclencheur</dt><dd t-esc="w.trigger_description or '—'"/></div>
                        <div><dt>Type de déclenchement</dt><dd t-esc="w.trigger_type_label"/></div>
                        <div><dt>Statut</dt><dd t-esc="w.status_label"/></div>
                        <div><dt>Responsable</dt><dd t-esc="w.owner or '—'"/></div>
                        <div><dt>Modèle d'origine</dt><dd t-esc="w.template_name or '—'"/></div>
                        <div><dt>Créé le</dt><dd t-esc="w.created or '—'"/></div>
                        <div><dt>Dernière exécution</dt><dd t-esc="w.last_run_label or '—'"/></div>
                        <div><dt>Temps économisé</dt><dd><t t-esc="w.time_saved_hours"/> h</dd></div>
                    </dl>
                </div>
            </t>

            <!-- ===== MODALES ===== -->
            <t t-if="state.builderOpen">
                <WorkflowBuilderDialog workflowId="workflowId"
                                       onSaved.bind="onSaved" onClose.bind="closeBuilder"/>
            </t>
            <t t-if="state.testOpen">
                <WorkflowTestDialog workflowId="workflowId" title="w.title"
                                    onDone.bind="onTestDone" onClose.bind="closeTest"/>
            </t>
            <t t-if="state.confirmDelete">
                <div class="civora-drawer-overlay" t-on-click="cancelDelete"/>
                <div class="civora-drawer civora-drawer--modal civora-drawer--sm civora-wf-confirm">
                    <div class="civora-drawer-head">
                        <div class="civora-drawer-head-txt">
                            <div class="civora-drawer-ico civora-drawer-ico--danger"><i class="fa fa-trash-o"/></div>
                            <div class="civora-drawer-head-labels">
                                <div class="civora-drawer-title">Supprimer le workflow</div>
                                <div class="civora-drawer-sub">Cette action est définitive.</div>
                            </div>
                        </div>
                        <button class="civora-drawer-close" t-on-click="cancelDelete"><i class="fa fa-times"/></button>
                    </div>
                    <div class="civora-drawer-body">
                        <p>Le workflow <strong t-esc="w.title"/> et son journal seront supprimés.</p>
                    </div>
                    <div class="civora-drawer-foot">
                        <button class="civora-btn civora-btn-ghost" t-on-click="cancelDelete">Annuler</button>
                        <button class="civora-btn civora-btn-danger" t-on-click="doDelete">
                            <i class="fa fa-trash-o"/> Supprimer
                        </button>
                    </div>
                </div>
            </t>
        </t>
    </div>
</t>
</templates>
