<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_ventes.SalesScreen">
    <div class="civora-ventes-screen">

        <!-- ============ HEADER ============ -->
        <div class="civora-screen-header">
            <div class="civora-screen-title">
                <h1>Ventes immobilières</h1>
                <span class="civora-screen-subtitle">Pipeline transactionnel · suivi compromis, actes, commissions</span>
            </div>
            <div class="civora-screen-actions">
                <button class="civora-btn civora-btn-outline" t-on-click="exportSales">
                    <i class="fa fa-download"/> Exporter
                </button>
                <button class="civora-btn civora-btn-accent" t-on-click="() => this.openDrawer('create')">
                    + Nouvelle vente
                </button>
            </div>
        </div>

        <!-- ============ KPIs ============ -->
        <div class="civora-kpi-grid">
            <CivoraStatCard
                label="'PIPELINE ACTIF'"
                value="fmtMoney(state.kpis.pipeline_value) + ' FCFA'"
                hint="(state.kpis.active || 0) + ' dossiers'"
                icon="'fa fa-line-chart'"
                trend="'up'"/>
            <CivoraStatCard
                label="'VOLUME SIGNÉ YTD'"
                value="fmtMoney(state.kpis.volume_signed) + ' FCFA'"
                delta="'+18% vs 2025'"
                icon="'fa fa-handshake-o'"
                trend="'up'"/>
            <CivoraStatCard
                label="'COMMISSIONS À VENIR'"
                value="fmtMoney(state.kpis.commission_total) + ' FCFA'"
                hint="'moy. ' + (state.kpis.avg_commission_rate || 0) + '%'"
                icon="'fa fa-percent'"
                trend="'up'"/>
            <CivoraStatCard
                label="'TAUX DE TRANSFORMATION'"
                value="(state.kpis.transformation_rate || 0) + '%'"
                hint="'Pipeline → Acte'"
                icon="'fa fa-check-circle'"
                trend="'up'"/>
        </div>

        <!-- ============ IA INSIGHT ============ -->
        <div class="civora-insight civora-ventes-insight">
            <div class="civora-insight-row">
                <div class="civora-insight-spark"><i class="fa fa-magic"/></div>
                <div class="civora-insight-main">
                    <div class="civora-insight-tag">IA · INSIGHT</div>
                    <div class="civora-insight-title" t-esc="insightTitle"/>
                    <p class="civora-insight-body" t-esc="insightBody"/>
                    <div class="civora-insight-action">
                        <button class="civora-btn civora-btn-outline" t-on-click="openActionPlan">
                            Voir le plan d'action IA
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ SEARCH BAR ============ -->
        <div class="civora-ventes-search-row">
            <div class="civora-ventes-search-box">
                <i class="fa fa-search"/>
                <input type="text" placeholder="Rechercher bien, acquéreur, vendeur, commercial..."
                       t-on-input="onSearch" t-att-value="state.search"/>
            </div>
            <button class="civora-btn civora-btn-outline" t-on-click="toggleFilters">
                <i class="fa fa-filter"/> Filtres
            </button>
        </div>

        <t t-if="state.showFilters">
            <div class="civora-ventes-filterpanel">
                <div class="civora-ventes-filterfield">
                    <label>Commercial</label>
                    <select class="civora-input" t-on-change="onFilterAgent">
                        <option value="all" t-att-selected="isAgent('all')">Tous les commerciaux</option>
                        <t t-foreach="agentOptions" t-as="a" t-key="a.id">
                            <option t-att-value="a.name" t-att-selected="isAgent(a.name)" t-esc="a.name"/>
                        </t>
                    </select>
                </div>
                <div class="civora-ventes-filterfield">
                    <label>Zone</label>
                    <select class="civora-input" t-on-change="onFilterZone">
                        <option value="all" t-att-selected="isZone('all')">Toutes les zones</option>
                        <t t-foreach="zoneOptions" t-as="z" t-key="z">
                            <option t-att-value="z" t-att-selected="isZone(z)" t-esc="z"/>
                        </t>
                    </select>
                </div>
                <button class="civora-btn civora-btn-outline" t-on-click="resetFilters">
                    <i class="fa fa-times"/> Réinitialiser
                </button>
            </div>
        </t>

        <!-- ============ TABS ============ -->
        <div class="civora-ventes-tabs">
            <t t-foreach="tabs" t-as="tab" t-key="tab.key">
                <button t-attf-class="civora-ventes-tab {{ state.activeTab === tab.key ? 'active' : '' }}"
                        t-on-click="() => this.setTab(tab.key)">
                    <t t-esc="tab.label"/>
                    <span t-if="tab.count" class="civora-ventes-tab-count"><t t-esc="tab.count"/></span>
                </button>
            </t>
        </div>

        <!-- ============ TAB: PIPELINE (Kanban) ============ -->
        <t t-if="state.activeTab === 'pipeline'">
            <div class="civora-pipeline">
                <t t-foreach="state.pipeline" t-as="col" t-key="col.key">
                    <div class="civora-pipeline-col">
                        <div class="civora-pipeline-col-header">
                            <span t-attf-class="civora-pipeline-col-badge civora-pipeline-badge-{{ col.key }}">
                                <t t-esc="col.label"/>
                            </span>
                            <span class="civora-pipeline-col-count"><t t-esc="col.count"/></span>
                            <span class="civora-pipeline-col-total"><t t-esc="fmtMoney(col.total)"/></span>
                        </div>
                        <div class="civora-pipeline-cards">
                            <t t-foreach="col.cards" t-as="card" t-key="card.id">
                                <div class="civora-pipeline-card" t-on-click="() => this.openDetail(card.id)">
                                    <div class="civora-pipeline-card-top">
                                        <span class="civora-pipeline-card-ref"><t t-esc="card.name"/></span>
                                        <span class="civora-pipeline-card-amount"><t t-esc="fmtMoney(card.amount)"/></span>
                                    </div>
                                    <div class="civora-pipeline-card-property"><t t-esc="card.property_name"/></div>
                                    <div class="civora-pipeline-card-city"><t t-esc="card.city"/></div>
                                    <div class="civora-pipeline-card-bottom">
                                        <span class="civora-pipeline-card-comm"><t t-esc="card.commission_rate"/>% comm.</span>
                                        <span class="civora-pipeline-card-agent" t-if="card.agent_initials">
                                            <t t-esc="card.agent_initials"/>
                                        </span>
                                    </div>
                                    <div class="civora-pipeline-card-date"><t t-esc="card.date"/></div>
                                </div>
                            </t>
                            <t t-if="!col.cards.length">
                                <div class="civora-pipeline-empty">Aucun dossier</div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </t>

        <!-- ============ TAB: TRANSACTIONS (Table) ============ -->
        <t t-if="state.activeTab === 'transactions'">
            <div class="civora-filters-bar">
                <div class="civora-pills">
                    <button t-attf-class="civora-pill {{ state.filter === 'all' ? 'active' : '' }}" t-on-click="() => this.setFilter('all')">Tous</button>
                    <button t-attf-class="civora-pill {{ state.filter === 'mandats' ? 'active' : '' }}" t-on-click="() => this.setFilter('mandats')">Mandats</button>
                    <button t-attf-class="civora-pill {{ state.filter === 'offres' ? 'active' : '' }}" t-on-click="() => this.setFilter('offres')">Offres</button>
                    <button t-attf-class="civora-pill {{ state.filter === 'compromis' ? 'active' : '' }}" t-on-click="() => this.setFilter('compromis')">Compromis</button>
                    <button t-attf-class="civora-pill {{ state.filter === 'acte' ? 'active' : '' }}" t-on-click="() => this.setFilter('acte')">Acte</button>
                    <button t-attf-class="civora-pill {{ state.filter === 'cloture' ? 'active' : '' }}" t-on-click="() => this.setFilter('cloture')">Clotures</button>
                </div>
            </div>
            <div class="civora-table-wrapper">
                <table class="civora-table">
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>Bien</th>
                            <th>Vendeur</th>
                            <th>Acquéreur</th>
                            <th>Prix demande</th>
                            <th>Prix vente</th>
                            <th>Mandat</th>
                            <th>Commission</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="filteredSales" t-as="s" t-key="s.id">
                            <tr class="civora-table-row" t-on-click="() => this.openDetail(s.id)">
                                <td class="civora-ref"><t t-esc="s.name"/></td>
                                <td><t t-esc="s.property_id ? s.property_id[1] : ''"/></td>
                                <td><t t-esc="s.seller_id ? s.seller_id[1] : ''"/></td>
                                <td><t t-esc="s.buyer_id ? s.buyer_id[1] : '—'"/></td>
                                <td class="text-right"><t t-esc="fmtMoneyFull(s.asking_price)"/></td>
                                <td class="text-right font-semibold"><t t-esc="s.sale_amount ? fmtMoneyFull(s.sale_amount) + ' F' : '—'"/></td>
                                <td><span class="civora-mandate-badge"><t t-esc="mandateLabel(s.mandate_type)"/></span></td>
                                <td class="text-right"><t t-esc="s.commission_amount ? fmtMoneyFull(s.commission_amount) + ' F' : '—'"/></td>
                                <td>
                                    <span t-attf-class="civora-status-badge civora-status-{{ stateClass(s.state) }}">
                                        <t t-esc="stateLabel(s.state)"/>
                                    </span>
                                </td>
                            </tr>
                        </t>
                        <t t-if="filteredSales.length === 0">
                            <tr><td colspan="9" class="civora-empty">Aucun dossier de vente</td></tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>

        <!-- ============ TAB: COMMISSIONS ============ -->
        <t t-if="state.activeTab === 'commissions'">
            <div class="civora-ventes-cols">
                <div class="civora-ventes-card">
                    <h3 class="civora-ventes-cardtitle">Commissions par commercial</h3>
                    <div class="civora-ventes-cardsub">Période en cours</div>
                    <t t-foreach="state.dash.agents or []" t-as="a" t-key="a.id">
                        <div class="civora-ventes-agentrow">
                            <span class="civora-ventes-avatar" t-esc="a.initials"/>
                            <div class="civora-ventes-agentmain">
                                <div class="civora-ventes-strong" t-esc="a.name"/>
                                <div class="civora-ventes-sub"><t t-esc="a.deals"/> dossiers actifs</div>
                            </div>
                            <div class="civora-ventes-agentamount">
                                <div class="civora-ventes-strong"><t t-esc="fmtMoney(a.total)"/> FCFA</div>
                                <div class="civora-ventes-sub">
                                    <t t-esc="fmtMoney(a.cashed)"/> encaissé ·
                                    <t t-esc="fmtMoney(a.pending)"/> à venir
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-if="!(state.dash.agents or []).length">
                        <div class="civora-ventes-empty">Aucun dossier actif.</div>
                    </t>

                    <h3 class="civora-ventes-cardtitle">Dernières commissions</h3>
                    <t t-foreach="state.dash.recent_commissions or []" t-as="c" t-key="c.id">
                        <div class="civora-ventes-commrow" t-on-click="() => this.openDetail(c.id)">
                            <div>
                                <div class="civora-ventes-strong">
                                    <t t-esc="c.ref"/> · <t t-esc="c.property"/>
                                </div>
                                <div class="civora-ventes-sub">
                                    <t t-esc="c.agent"/> · <t t-esc="c.rate"/>% =
                                    <t t-esc="fmtMoneyFull(c.amount)"/> FCFA
                                </div>
                            </div>
                            <span class="civora-ventes-sub" t-esc="c.date"/>
                        </div>
                    </t>
                    <t t-if="!(state.dash.recent_commissions or []).length">
                        <div class="civora-ventes-empty">Aucune commission enregistrée.</div>
                    </t>
                </div>

                <div class="civora-ventes-card">
                    <h3 class="civora-ventes-cardtitle">Synthèse</h3>
                    <div class="civora-ventes-deflist">
                        <div><span>COMMISSIONS TOTALES</span>
                             <strong><t t-esc="fmtMoneyFull(state.dash.commission_summary.total)"/> FCFA</strong></div>
                        <div><span>ENCAISSÉES</span>
                             <strong><t t-esc="fmtMoneyFull(state.dash.commission_summary.cashed)"/> FCFA</strong></div>
                        <div><span>À ENCAISSER</span>
                             <strong><t t-esc="fmtMoneyFull(state.dash.commission_summary.pending)"/> FCFA</strong></div>
                        <div><span>COMMERCIAUX</span>
                             <strong t-esc="state.dash.commission_summary.agents"/></div>
                        <div><span>TAUX MOYEN</span>
                             <strong><t t-esc="state.dash.commission_summary.avg_rate"/>%</strong></div>
                    </div>
                </div>
            </div>
        </t>

        <!-- ============ TAB: PERFORMANCE ============ -->
        <t t-if="state.activeTab === 'performance'">
            <div class="civora-ventes-cols">
                <div class="civora-ventes-card">
                    <h3 class="civora-ventes-cardtitle">Volume par zone</h3>
                    <div class="civora-ventes-cardsub">Dossiers signés, en cours d'acte ou clôturés</div>
                    <t t-foreach="state.dash.zones or []" t-as="z" t-key="z.name">
                        <div class="civora-ventes-zonerow">
                            <div class="civora-ventes-zoneline">
                                <span class="civora-ventes-strong" t-esc="z.name"/>
                                <span class="civora-ventes-sub">
                                    <t t-esc="fmtMoney(z.volume)"/> FCFA · <t t-esc="z.count"/> ventes
                                </span>
                            </div>
                            <div class="civora-ventes-bartrack">
                                <div class="civora-ventes-barfill" t-attf-style="width:{{ z.pct }}%"/>
                            </div>
                        </div>
                    </t>
                    <t t-if="!(state.dash.zones or []).length">
                        <div class="civora-ventes-empty">Aucune vente signée sur la période.</div>
                    </t>
                </div>

                <div class="civora-ventes-card">
                    <h3 class="civora-ventes-cardtitle">Cycle de vente</h3>
                    <div class="civora-ventes-deflist">
                        <div><span>DÉLAI PROMESSE → ACTE</span>
                             <strong>
                                 <t t-if="state.dash.cycle.promise_to_acte"><t t-esc="state.dash.cycle.promise_to_acte"/> j</t>
                                 <t t-else="">—</t>
                             </strong></div>
                        <div><span>DÉLAI ACTE → ENCAISSÉ</span>
                             <strong>
                                 <t t-if="state.dash.cycle.acte_to_cash"><t t-esc="state.dash.cycle.acte_to_cash"/> j</t>
                                 <t t-else="">—</t>
                             </strong></div>
                        <div><span>ANNULATIONS</span>
                             <strong><t t-esc="state.dash.cycle.cancelled"/> dossier(s)</strong></div>
                        <div><span>TICKET MOYEN</span>
                             <strong><t t-esc="fmtMoneyFull(state.dash.cycle.ticket)"/> FCFA</strong></div>
                    </div>

                    <h3 class="civora-ventes-cardtitle">Alertes</h3>
                    <t t-foreach="alerts" t-as="al" t-key="al.id">
                        <div t-attf-class="civora-ventes-alert civora-ventes-alert--{{ al.level }}"
                             t-on-click="() => this.openDetail(al.sale_id)">
                            <i class="fa fa-exclamation-circle"/> <t t-esc="al.text"/>
                        </div>
                    </t>
                    <t t-if="!alerts.length">
                        <div class="civora-ventes-empty">Aucune alerte : tous les dossiers sont dans les délais.</div>
                    </t>
                </div>
            </div>
        </t>

        <!-- ============ DRAWER ============ -->
        <t t-if="state.drawerOpen">
            <SaleDrawer
                mode="state.drawerMode"
                recordId="state.drawerRecordId"
                onSaved.bind="onSaved"
                onClose.bind="closeDrawer"/>
        </t>
    </div>
</t>
</templates>
