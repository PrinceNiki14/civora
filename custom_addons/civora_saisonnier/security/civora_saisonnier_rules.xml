<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="rule_reservation_company" model="ir.rule">
        <field name="name">Réservations : multi-société</field>
        <field name="model_id" ref="model_civora_reservation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_review_company" model="ir.rule">
        <field name="name">Avis : multi-société</field>
        <field name="model_id" ref="model_civora_reservation_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_cleaning_company" model="ir.rule">
        <field name="name">Ménages : multi-société</field>
        <field name="model_id" ref="model_civora_cleaning_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_tariff_company" model="ir.rule">
        <field name="name">Tarifs saisonniers : multi-société</field>
        <field name="model_id" ref="model_civora_seasonal_tariff"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
