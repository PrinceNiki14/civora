<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_saisonnier.ReservationDrawer">
    <!-- Modale CENTREE comme la demo (carte de 486px), et non plus un panneau
         lateral. Ordre des champs identique : Voyageur, Bien, dates, canal et
         statut, puis les revenus. -->
    <CivoraDrawer variant="'modal'" size="'sm'"
                  title="props.mode === 'edit' ? 'Modifier la réservation' : 'Nouvelle réservation'"
                  onClose="props.onClose">
        <div class="civora-resa-form">

            <div class="civora-resa-field">
                <label>Voyageur <span class="civora-req">*</span></label>
                <select t-on-change="(ev) => this.setField('guest_id', ev)">
                    <option value="">— Sélectionner —</option>
                    <t t-foreach="state.contacts" t-as="c" t-key="c.id">
                        <option t-att-value="c.id" t-att-selected="state.form.guest_id === c.id">
                            <t t-esc="c.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="civora-resa-field">
                <label>Bien <span class="civora-req">*</span></label>
                <select t-on-change="(ev) => this.onPropertyChange(ev)">
                    <option value="">— Sélectionner —</option>
                    <t t-foreach="state.properties" t-as="p" t-key="p.id">
                        <option t-att-value="p.id" t-att-selected="state.form.property_id === p.id">
                            <t t-esc="p.name"/>
                        </option>
                    </t>
                </select>
            </div>

            <!-- La demo demande "Jour arrivee" (un numero de jour du mois) et
                 un nombre de nuits : impossible de reserver a cheval sur deux
                 mois. On garde arrivee + depart, et on affiche le nombre de
                 nuits calcule, qui est l'information que la demo montrait. -->
            <div class="civora-resa-grid2">
                <div class="civora-resa-field">
                    <label>Arrivée <span class="civora-req">*</span></label>
                    <input type="date" t-att-value="state.form.checkin_date"
                           t-on-input="(ev) => this.setField('checkin_date', ev)"/>
                </div>
                <div class="civora-resa-field">
                    <label>Départ <span class="civora-req">*</span></label>
                    <input type="date" t-att-value="state.form.checkout_date"
                           t-on-input="(ev) => this.setField('checkout_date', ev)"/>
                </div>
            </div>

            <div class="civora-resa-grid2">
                <div class="civora-resa-field">
                    <label>Canal</label>
                    <select t-on-change="(ev) => this.setField('source', ev)">
                        <t t-foreach="SOURCES" t-as="s" t-key="s[0]">
                            <option t-att-value="s[0]" t-att-selected="state.form.source === s[0]">
                                <t t-esc="s[1]"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="civora-resa-field">
                    <label>Statut</label>
                    <select t-on-change="(ev) => this.setField('state', ev)">
                        <t t-foreach="STATES" t-as="s" t-key="s[0]">
                            <option t-att-value="s[0]" t-att-selected="state.form.state === s[0]">
                                <t t-esc="s[1]"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <div class="civora-resa-grid2">
                <div class="civora-resa-field">
                    <label>Tarif / nuit (FCFA) <span class="civora-req">*</span></label>
                    <input type="number" min="0" step="5000" t-ref="tariff"
                           t-att-value="state.form.tariff_night"
                           t-on-input="(ev) => this.setField('tariff_night', ev)"/>
                </div>
                <div class="civora-resa-field">
                    <label>Voyageurs</label>
                    <input type="number" min="1" step="1" t-att-value="state.form.num_guests"
                           t-on-input="(ev) => this.setField('num_guests', ev)"/>
                </div>
            </div>

            <!-- "Revenus (FCFA)" de la demo, mais CALCULE : le laisser
                 saisissable permettrait d'enregistrer un sejour dont le total
                 contredit son propre tarif. -->
            <div class="civora-resa-total">
                <span class="civora-resa-total-k">Revenus (FCFA)</span>
                <span class="civora-resa-total-v"><t t-esc="totalLabel"/></span>
                <span class="civora-resa-total-sub"><t t-esc="nightsLabel"/></span>
            </div>

            <div class="civora-resa-more">
                <button type="button" class="civora-resa-more-toggle"
                        t-on-click="() => this.toggleMore()">
                    <i t-attf-class="fa fa-chevron-{{ state.showMore ? 'down' : 'right' }}"/>
                    Caution, accès et notes
                </button>

                <t t-if="state.showMore">
                    <div class="civora-resa-more-body">
                        <div class="civora-resa-field">
                            <label>Caution (FCFA)</label>
                            <input type="number" min="0" step="10000"
                                   t-att-value="state.form.deposit_amount"
                                   t-on-input="(ev) => this.setField('deposit_amount', ev)"/>
                        </div>
                        <div class="civora-resa-field">
                            <label>Instructions d'accès</label>
                            <textarea rows="2" placeholder="Code portail, gardien…"
                                      t-on-input="(ev) => this.setField('access_instructions', ev)"><t t-esc="state.form.access_instructions"/></textarea>
                        </div>
                        <div class="civora-resa-field">
                            <label>Notes</label>
                            <textarea rows="2" placeholder="Notes internes…"
                                      t-on-input="(ev) => this.setField('notes', ev)"><t t-esc="state.form.notes"/></textarea>
                        </div>
                    </div>
                </t>
            </div>
        </div>

        <t t-set-slot="footer">
            <button class="civora-btn civora-btn-outline" t-on-click="props.onClose">Annuler</button>
            <button class="civora-btn civora-btn-accent" t-on-click="save" t-att-disabled="state.saving">
                <t t-if="state.saving">Enregistrement…</t>
                <t t-else=""><t t-esc="props.mode === 'edit' ? 'Enregistrer' : 'Créer'"/></t>
            </button>
        </t>
    </CivoraDrawer>
</t>
<t t-name="civora_saisonnier.CleaningTaskDialog">
    <CivoraDrawer variant="'modal'" size="'md'" icon="'fa-magic'"
                  title="dialogTitle" onClose="props.onClose">
        <div class="civora-sais-taskform">
            <t t-if="state.error">
                <div class="civora-sais-error"><i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/></div>
            </t>

            <div class="civora-sais-taskgrid">
                <div class="civora-sais-taskfield">
                    <label>Bien *</label>
                    <select class="civora-input" t-on-change="(ev) => this.update('property_id', ev)">
                        <t t-foreach="state.properties" t-as="p" t-key="p.id">
                            <option t-att-value="p.id" t-att-selected="isValue('property_id', p.id)" t-esc="p.name"/>
                        </t>
                    </select>
                </div>
                <div class="civora-sais-taskfield">
                    <label>Type d'intervention</label>
                    <select class="civora-input" t-on-change="(ev) => this.update('task_type', ev)">
                        <t t-foreach="types" t-as="t" t-key="t.id">
                            <option t-att-value="t.id" t-att-selected="isValue('task_type', t.id)" t-esc="t.label"/>
                        </t>
                    </select>
                </div>
                <div class="civora-sais-taskfield">
                    <label>Date *</label>
                    <input type="date" class="civora-input" t-att-value="state.values.date"
                           t-on-change="(ev) => this.update('date', ev)"/>
                </div>
                <div class="civora-sais-taskfield">
                    <label>Créneau</label>
                    <select class="civora-input" t-on-change="(ev) => this.update('time_slot', ev)">
                        <t t-foreach="slots" t-as="sl" t-key="sl.id">
                            <option t-att-value="sl.id" t-att-selected="isValue('time_slot', sl.id)" t-esc="sl.label"/>
                        </t>
                    </select>
                </div>
                <div class="civora-sais-taskfield">
                    <label>Intervenant</label>
                    <select class="civora-input" t-on-change="(ev) => this.update('staff_id', ev)">
                        <option value="" t-att-selected="isValue('staff_id', '')">— À assigner —</option>
                        <t t-foreach="state.staff" t-as="st" t-key="st.id">
                            <option t-att-value="st.id" t-att-selected="isValue('staff_id', st.id)">
                                <t t-esc="st.name"/> · <t t-esc="st.speciality"/>
                            </option>
                        </t>
                    </select>
                    <span class="civora-sais-taskhint">Sans intervenant, la tâche reste « à planifier ».</span>
                </div>
                <div class="civora-sais-taskfield">
                    <label>Priorité</label>
                    <select class="civora-input" t-on-change="(ev) => this.update('priority', ev)">
                        <t t-foreach="priorities" t-as="pr" t-key="pr.id">
                            <option t-att-value="pr.id" t-att-selected="isValue('priority', pr.id)" t-esc="pr.label"/>
                        </t>
                    </select>
                </div>
            </div>

            <div class="civora-sais-taskfield">
                <label>Consignes</label>
                <textarea class="civora-input" rows="2" placeholder="Points de vigilance, matériel, accès…"
                          t-on-change="(ev) => this.update('notes', ev)"><t t-esc="state.values.notes"/></textarea>
            </div>
        </div>

        <t t-set-slot="footer">
            <button class="civora-btn civora-btn-ghost" t-on-click="() => props.onClose()">Annuler</button>
            <button class="civora-btn civora-btn-accent" t-att-disabled="state.saving" t-on-click="save">
                <i class="fa fa-check"/> <t t-esc="isEdit ? 'Enregistrer' : 'Planifier la tâche'"/>
            </button>
        </t>
    </CivoraDrawer>
</t>

</templates>
