<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="civora_equipe.Member360">
    <div class="civora-member-360">
        <t t-if="state.member">
            <t t-set="m" t-value="state.member"/>

            <!-- Breadcrumb -->
            <div class="m360-breadcrumb">
                <span class="m360-breadcrumb-link" t-on-click="goBack">Equipe</span>
                <span class="m360-breadcrumb-sep">/</span>
                <span class="m360-breadcrumb-current"><t t-esc="m.name"/></span>
            </div>

            <!-- Page title -->
            <div class="m360-page-title">
                <h1>Fiche collaborateur</h1>
                <p class="m360-page-subtitle">Performance, planning et permissions</p>
            </div>

            <!-- Member card -->
            <div class="m360-member-card">
                <div class="m360-member-left">
                    <div class="m360-avatar">
                        <span class="m360-avatar-initials"><t t-esc="m.initials || '??'"/></span>
                    </div>
                    <div class="m360-member-info">
                        <h2 class="m360-member-name"><t t-esc="m.name"/></h2>
                        <div class="m360-member-role-line">
                            <span t-if="m.role"><t t-esc="m.role"/></span>
                            <span t-if="m.location" class="m360-dot-sep">·</span>
                            <span t-if="m.location"><t t-esc="m.location"/></span>
                            <span class="m360-dot-sep">·</span>
                            <span><t t-esc="presenceLabel"/></span>
                        </div>
                        <div class="m360-badges">
                            <span class="m360-badge-pill">Perf. <t t-esc="perfBadge"/>%</span>
                            <span class="m360-badge-pill">Objectifs <t t-esc="objectifPct"/>%</span>
                            <span class="m360-badge-pill"><t t-esc="anciennete"/> ans d'anciennete</span>
                        </div>
                    </div>
                </div>
                <div class="m360-member-actions">
                    <button class="m360-icon-btn" title="Appeler">
                        <i class="fa fa-phone"/>
                    </button>
                    <button class="m360-icon-btn" title="Message">
                        <i class="fa fa-comment-o"/>
                    </button>
                    <button class="m360-btn-outline">Modifier</button>
                    <button class="m360-btn-accent">Affecter un lead</button>
                </div>
            </div>

            <!-- Tabs -->
            <div class="m360-tabs">
                <t t-foreach="tabsWithCounts" t-as="tab" t-key="tab.key">
                    <button t-attf-class="m360-tab {{ state.activeTab === tab.key ? 'active' : '' }}"
                            t-on-click="() => this.setTab(tab.key)">
                        <t t-esc="tab.label"/>
                        <span t-if="tab.count" class="m360-tab-count"><t t-esc="tab.count"/></span>
                    </button>
                </t>
            </div>

            <!-- Tab: Vue d'ensemble -->
            <t t-if="state.activeTab === 'overview'">
                <div class="m360-kpi-row">
                    <div class="m360-kpi-card">
                        <div class="m360-kpi-label">COMMISSIONS Q4</div>
                        <div class="m360-kpi-value"><t t-esc="commissionDisplay"/> FCFA</div>
                        <div class="m360-kpi-sub"><t t-esc="m.deal_count || 0"/> deals fermes</div>
                    </div>
                    <div class="m360-kpi-card">
                        <div class="m360-kpi-label">ATTEINTE OBJECTIF</div>
                        <div class="m360-kpi-value"><t t-esc="objectifPct"/>%</div>
                        <div class="m360-kpi-sub">cible <t t-esc="Math.max(m.deal_count || 0, 10)"/> deals</div>
                    </div>
                    <div class="m360-kpi-card">
                        <div class="m360-kpi-label">MANDATS ACTIFS</div>
                        <div class="m360-kpi-value"><t t-esc="mandatsActifs"/></div>
                        <div class="m360-kpi-sub">+<t t-esc="Math.max(1, Math.round((m.deal_count || 0) * 0.2))"/> ce mois</div>
                    </div>
                    <div class="m360-kpi-card">
                        <div class="m360-kpi-label">NOTE INTERNE</div>
                        <div class="m360-kpi-value"><t t-esc="ratingDisplay"/>/5</div>
                        <div class="m360-kpi-sub">Perf. <t t-esc="perfBadge"/>%</div>
                    </div>
                </div>

                <div class="m360-bottom-grid">
                    <!-- IA Insight -->
                    <div class="m360-insight-card">
                        <div class="m360-insight-header">
                            <span class="m360-insight-icon">&#10024;</span>
                            <span class="m360-insight-title">IA INSIGHT</span>
                        </div>
                        <p class="m360-insight-text">
                            Performance exceptionnelle ce trimestre.
                            <t t-esc="m.name"/> depasse ses objectifs avec un taux d'atteinte de <t t-esc="objectifPct"/>%.
                            Recommandation : envisager un bonus de performance ou une promotion.
                        </p>
                        <button class="m360-btn-accent m360-insight-btn">Valider bonus</button>
                    </div>

                    <!-- Coordonnees -->
                    <div class="m360-coord-card">
                        <h3 class="m360-coord-title">Coordonnees</h3>
                        <div class="m360-coord-item">
                            <i class="fa fa-envelope-o"/>
                            <span><t t-esc="m.email || '---'"/></span>
                        </div>
                        <div class="m360-coord-item">
                            <i class="fa fa-phone"/>
                            <span><t t-esc="m.phone || '---'"/></span>
                        </div>
                        <div class="m360-coord-item" t-if="m.location">
                            <i class="fa fa-map-marker"/>
                            <span><t t-esc="m.location"/></span>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Tab: Performance -->
            <t t-if="state.activeTab === 'performance'">
                <div class="m360-placeholder-tab">
                    <i class="fa fa-line-chart"/>
                    <h3>Performance</h3>
                    <p>Graphiques de performance et historique des KPIs. Module en cours de developpement.</p>
                </div>
            </t>

            <!-- Tab: Portefeuille -->
            <t t-if="state.activeTab === 'portfolio'">
                <div class="m360-placeholder-tab">
                    <i class="fa fa-briefcase"/>
                    <h3>Portefeuille</h3>
                    <p>Liste des mandats, biens et clients assignes. Module en cours de developpement.</p>
                </div>
            </t>

            <!-- Tab: Planning -->
            <t t-if="state.activeTab === 'planning'">
                <div class="m360-placeholder-tab">
                    <i class="fa fa-calendar"/>
                    <h3>Planning</h3>
                    <p>Calendrier des visites, rendez-vous et evenements. Module en cours de developpement.</p>
                </div>
            </t>

            <!-- Tab: Commissions -->
            <t t-if="state.activeTab === 'commissions'">
                <div class="m360-placeholder-tab">
                    <i class="fa fa-money"/>
                    <h3>Commissions</h3>
                    <p>Detail des commissions et historique de paiement. Module en cours de developpement.</p>
                </div>
            </t>

            <!-- Tab: Permissions -->
            <t t-if="state.activeTab === 'permissions'">
                <div class="m360-placeholder-tab">
                    <i class="fa fa-lock"/>
                    <h3>Permissions</h3>
                    <p>Gestion des droits d'acces et des roles. Module en cours de developpement.</p>
                </div>
            </t>

        </t>
        <t t-else="">
            <div class="m360-loading">
                <i class="fa fa-spinner fa-spin"/>
                <span>Chargement de la fiche collaborateur...</span>
            </div>
        </t>
    </div>
</t>
</templates>
