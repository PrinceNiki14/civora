<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_retenue_wizard_from_view" model="ir.ui.view">
            <field name="name">hr.retenue.wizard.form</field>
            <field name="model">hr.retenue.wizard</field>
            <field name="arch" type="xml">
                <form string="Rapport de retenue">
                    <group>
                        <group>
                            <field name="lot_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="salary_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Imprimer(PDF)" name="print_retenue_wizard" type="object" class="btn-primary" icon="fa-download"/>
                        <button string="Exporter en Excel" name="export_xls" type="object" class="btn-primary" icon="fa-download"/>
                        <button string="Annuler" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_retenue_wizard" model="ir.actions.act_window">
            <field name="name">Rapport de retenue</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.retenue.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="hr_retenue_wizard_book_menu"
                  name="Rapport Retenue"
                  sequence="6"
                  parent="hr_payroll.menu_hr_payroll_report"
                  action="action_hr_retenue_wizard"/>

    </data>
</odoo>