<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_salary_rule_form_view" model="ir.ui.view">
            <field name="name">hr.salary.rule form_view</field>
            <field name="model">hr.salary.rule</field>
            <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='appears_on_payslip']" position="after">
                    <field name="est_accessoire"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Information bancaire">
                        <group>
                            <group>
                                <field name="banque_id"/>
                                <field name="code_banque"/>
                                <field name="code_guichet"/>
                                <field name="num_compte_bancaire"/>
                                <field name="cle_rib"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="ordre_virement" model="ir.ui.view">
            <field name="name">ordre.virement.wizard.form</field>
            <field name="model">ordre.virement</field>
            <field name="arch" type="xml">
                <form string="Etat des virements">
                    <label for="name" string="Objet"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <!--<group>
                        <group>
                            <field name="type_employe" widget="radio"/>
                        </group>
                        <group>
                            <field name="nature_employe" widget="radio" />
                        </group>
                    </group>-->
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="type_virement"/>
                        </group>
                        <group>
                            <field name="attention_de"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Liste des bulletins de la période">
                            <field name="payslip_ids" />
                        </page>
                    </notebook>
                    <footer>
                        <button string="Imprimer" name="check_report" type="object" class="btn-primary"/>
                        <button string="Exporter en Excel" name="export_xls" type="object" class="btn-primary"
                            context="{'xls_export':1}" icon="fa-download"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_ordre_virement_wizard" model="ir.actions.act_window">
            <field name="name">Ordre de virement</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ordre.virement</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="ordre_virement_wizard_menu" name="Ordre de virement" sequence="51"
                  parent="hr_payroll.menu_hr_payroll_report" action="action_ordre_virement_wizard"/>
    </data>
</odoo>