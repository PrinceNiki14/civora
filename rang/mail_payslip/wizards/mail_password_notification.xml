<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="mail_pawword_notifwizard_form_view">
        <field name="name">mail.password.notification_wizard.form</field>
        <field name="model">mail.password.notification_wizard</field>
        <field name="arch" type="xml">
            <form string="Send via mail">
                <div><span>Assurez-vous d'avoir renseigner l'adresse email de l'employé et aussi d'avoir générer tous les mots de passe.</span></div>
                <footer>
                    <button name="send_email" type="object"
                        string="Enoyer via mail" class="oe_highlight"/>
                    or
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_mail_password_notification_wizard"
        name="Envoyer le mot de passe via mail"
        binding_model="hr.employee"
        res_model="mail.password.notification_wizard"
        view_mode="form"
        target="new"/>

    <record id="action_mail_payslip_send" model="ir.actions.server">
        <field name="name">Envoyer le mot de passe via mail</field>
        <field name="model_id" ref="hr_payroll.model_hr_employee"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_mail_payslip_send()</field>
    </record>
</odoo>
