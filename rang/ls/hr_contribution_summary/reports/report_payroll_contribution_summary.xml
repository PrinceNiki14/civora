<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_payroll_summary_contribution">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="text-center">
                                <h1>RÉSUMÉ DES COTISATIONS</h1>
                                PÉRIODE DU <span t-field="o.date_from"/> - <span t-field="o.date_to" />
                            </div>
                            <div>
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th rowspan="2">CODE</th>
                                            <th rowspan="2">RUBRIQUE</th>
                                            <th colspan="3">ASSIETTE DE COTISATION</th>
                                            <th colspan="3">PART EMPLOYÉ</th>
                                            <th colspan="3">PART EMPLOYEUR</th>
                                            <th rowspan="2">MONTANT GLOBAL</th>
                                        </tr>
                                        <tr>
                                            <th>LOCAL</th>
                                            <th>EXPATRIÉ</th>
                                            <th>TOTAL</th>
                                            <th>LOCAL</th>
                                            <th>EXPATRIÉ</th>
                                            <th>TOTAL</th>
                                            <th>LOCAL</th>
                                            <th>EXPATRIÉ</th>
                                            <th>TOTAL</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.type" t-as="type">
                                            <t t-set="element" t-value="o.compute_all(type)" />
                                            <tr>
                                                <t t-if="type == 'impot'">
                                                    <td colspan="2"><strong>TOTAL IMPOT</strong></td>
                                                </t>
                                                <t t-elif="type == 'cotisation'">
                                                    <td colspan="2"><strong>TOTAL CNPS</strong></td>
                                                </t>
                                                <t t-else="">
                                                    <td colspan="2"><strong>TOTAL CMU</strong></td>
                                                </t>
                                                <td colspan="3"></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(element['employee_contribution_local'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(element['employee_contribution_expat'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(element['employee_contribution'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(element['employer_contribution_local'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(element['employer_contribution_expat'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(element['employer_contribution'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(element['total'])" /></td>
                                            </tr>
                                            <tr t-foreach="element['lines']" t-as="line">
                                                <td></td>
                                                <td><span t-esc="line['name']" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['contribution_base_local'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['contribution_base_expat'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['contribution_base'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['employee_contribution_local'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['employee_contribution_expat'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['employee_contribution'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['employer_contribution_local'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['employer_contribution_expat'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['employer_contribution'])" /></td>
                                                <td class="text-end"><span t-esc="o.format_amount_fr(line['total'])" /></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
