<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Styles CSS personnalisés pour le rapport FNE -->
    <template id="report_invoice_fne_cia_style">
        <style>
            .fne-header-box {
                border: 2px solid #000;
                border-radius: 10px;
                padding: 15px;
                margin-bottom: 20px;
            }

            .fne-table {
                border-collapse: collapse;
                width: 100%;
                font-size: 12px;
            }

            .fne-table th, .fne-table td {
                border: 1px solid #000;
                padding: 8px;
                text-align: left;
            }

            .fne-table th {
                background-color: #f8f9fa;
                font-weight: bold;
            }

            .fne-totals-table {
                border-collapse: collapse;
                width: 100%;
                margin-top: 20px;
            }

            .fne-totals-table td {
                border: 1px solid #000;
                padding: 8px;
            }

            .fne-qr-section {
                text-align: center;
                margin: 20px 0;
            }

            .fne-logo-badge {
                background: linear-gradient(45deg, #ff6600, #ff8833);
                color: white;
                padding: 8px;
                border-radius: 8px;
                font-size: 11px;
                font-weight: bold;
                text-align: center;
                margin-top: 10px;
            }

            .fne-footer {
                font-size: 10px;
                text-align: center;
                border-top: 1px solid #ccc;
                padding-top: 15px;
                margin-top: 30px;
            }

            .fne-client-section {
                background-color: #f9f9f9;
                padding: 15px;
                border-left: 4px solid #ff6600;
                margin: 20px 0;
            }

            .monetary {
                font-weight: bold;
            }
        </style>
    </template>
</odoo>
