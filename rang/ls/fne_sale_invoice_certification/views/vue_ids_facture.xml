<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================== -->
    <!-- VUE LIGNES DE FACTURE DANS LA FACTURE (tree embedded) -->
    <!-- =================================================================== -->
    <record id="view_move_form_line_fne" model="ir.ui.view">
        <field name="name">account.move.form.line.fne</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Ajouter colonne ID FNE dans les lignes de facture -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="after">
                <field name="fne_item_id" readonly="1" optional="hide" 
                       column_invisible="parent.fne_certified == False"/>
            </xpath>

        </field>
    </record>

