<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- 1. VUE FORMULAIRE FACTURE - AJOUT CHAMPS FNE -->
    <!-- =================================================================== -->
    <record id="view_move_form_fne" model="ir.ui.view">
        <field name="name">account.move.form.fne</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Ajout du bouton de certification dans le header -->
            <header position="inside">
                <button name="action_certify_fne"
                        type="object"
                        string="Certifier FNE"
                        class="btn-primary"
                        invisible="move_type != 'out_invoice' or state != 'posted' or fne_certified"
                        confirm="Êtes-vous sûr de vouloir certifier cette facture auprès de la FNE ? Cette action est irréversible."
                        help="Certifier cette facture auprès de la FNE"/>

               <!--   <button name="action_view_fne_qr_code"
                        type="object"
                        string="Voir QR Code"
                        class="btn-secondary"
                        invisible="not fne_qr_url"
                        help="Afficher le QR code de vérification FNE"/>  -->

                <button name="action_debug_lines"
                        type="object"
                        string="Debug Lignes"
                        class="btn-secondary"
                        help="Déboguer les lignes de facture dans les logs"/>
            </header>

            <!-- Ajout d'un onglet FNE -->
            <xpath expr="//notebook" position="inside">
                <page string="Certification FNE" invisible="move_type != 'out_invoice'">

                    <!-- Section État de certification -->
                    <group string="État de la Certification">
                        <group>
                            <field name="fne_certified" readonly="1"/>
                            <field name="fne_reference" readonly="1" invisible="not fne_certified"/>
                            <field name="fne_qr_url" readonly="1" widget="url" invisible="not fne_certified"/>
                        </group>
                        <group>
                            <field name="fne_balance_sticker" readonly="1" invisible="not fne_certified"/>
                            <field name="fne_warning" readonly="1" invisible="not fne_certified"/>
                        </group>
                    </group>

                    <!-- Section QR Code -->
                    <group string="QR Code de Vérification" invisible="not fne_certified">
                        <div class="text-center">
                            <field name="fne_qr_code_image" widget="image"
                                   options="{'size': [150, 150]}"
                                   invisible="not fne_qr_code_image"
                                   nolabel="1"/>

                            <!-- Message si le QR code n'est pas généré -->
                            <div invisible="fne_qr_code_image" class="alert alert-info">
                                <p>QR Code non disponible</p>
                                <small>Vérifiez que le module Python 'qrcode' est installé</small>
                            </div>

                            <!-- Lien sous le QR code -->
                            <div invisible="not fne_qr_url">
                                <br/>
                                <a href="#" onclick="window.open(document.querySelector('[name=fne_qr_url]').value)">
                                    📱 Vérifier en ligne
                                </a>
                            </div>
                        </div>
                    </group>

                    <!-- Section Configuration FNE avec valeurs par défaut -->
                    <group string="Configuration FNE (Pré-remplie automatiquement)">
                        <group>
                            <field name="fne_template" required="1"/>
                            <field name="fne_client_ncc"
                                   required="fne_template == 'B2B'"
                                   invisible="fne_template != 'B2B'"/>
                            <field name="fne_point_of_sale"/>
                            <field name="fne_establishment"/>
                        </group>
                        <group>
                            <field name="fne_seller_name"/>
                            <field name="fne_payment_method"/>
                            <field name="fne_is_rne"/>
                            <field name="fne_rne_number"
                                   required="fne_is_rne"
                                   invisible="not fne_is_rne"/>
                                   
                                   <field name="fne_balance_sticker" 
       widget="monetary" 
       options="{'currency_field': 'currency_id'}"
       readonly="1"/>
                        </group>
                    </group>

                    <!-- Section Messages avec valeurs par défaut -->
                    <group string="Messages Personnalisés (Pré-remplis automatiquement)">
                        <field name="fne_commercial_message"
                               placeholder="Message commercial par défaut depuis la configuration"/>
                        <field name="fne_footer_message"
                               placeholder="Message de pied de page depuis la configuration"/>
                    </group>

                    <!-- Section Données techniques (uniquement si certifié) -->
                    <group string="Données Techniques" invisible="not fne_certified">
                        <field name="fne_token" readonly="1"/>
                        <field name="fne_response_data" readonly="1" widget="text"/>
                    </group>

                </page>
            </xpath>

            <!-- Ajout d'indicateur visuel dans le titre avec société -->
            <xpath expr="//div[@class='oe_title']" position="after">
                <div class="alert alert-success" role="alert" invisible="not fne_certified">
                    <strong>✓ Facture Certifiée FNE</strong>
                    -
                    Société:
                    <field name="company_id" readonly="1" class="oe_inline"/>
                    <br/>
                    Référence:
                    <field name="fne_reference" readonly="1" class="oe_inline"/>
                    <br/>
                    <a href="#" class="btn btn-link btn-sm"
                       onclick="window.open(this.parentElement.querySelector('[name=fne_qr_url]').value)">
                        🔍 Voir le QR Code de vérification
                    </a>
                </div>

                <div class="alert alert-warning" role="alert" invisible="not fne_certified or not fne_warning">
                    <strong>⚠️ Attention:</strong>
                    Stock de stickers faible
                    (
                    <field name="fne_balance_sticker" readonly="1" class="oe_inline"/>
                    restants)
                </div>
            </xpath>

        </field>
    </record>

    <!-- =================================================================== -->
    <!-- 2. VUE LISTE - AJOUT COLONNE CERTIFICATION -->
    <!-- =================================================================== -->
    <record id="view_invoice_tree_fne" model="ir.ui.view">
        <field name="name">account.move.tree.fne</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">

            <field name="name" position="before">
                <field name="fne_certified_icon" string="📋" widget="html" readonly="1"
                       width="40px" nolabel="1"/>
            </field>

            <!-- Ajout colonne certification FNE -->
            <field name="state" position="after">
                <field name="fne_certified" string="FNE" widget="boolean_toggle"/>
                <field name="fne_reference" optional="hide"/>
            </field>

        </field>
    </record>

  <!-- =================================================================== -->
    <!-- 4. Ajout du Champ NCC dans la Views partner -->
    <!-- =================================================================== -->

    <record id="res_partner_view_ncc" model="ir.ui.view">
        <field name="name">res.partner.form.fne</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">


	     <xpath expr="//field[@name='vat']" position="after">
					
			<field name="ncc" readonly="1"/>
	
            </xpath>

        </field>
        
    </record>




    <!-- =================================================================== -->
    <!-- 4. FILTRE DE RECHERCHE FNE -->
    <!-- =================================================================== -->
    <record id="view_account_invoice_filter_fne" model="ir.ui.view">
        <field name="name">account.move.select.fne</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">

            <!-- Ajout filtres FNE -->
            <filter name="late" position="after">
                <separator/>
                <filter string="Certifiées FNE" name="fne_certified"
                        domain="[('fne_certified', '=', True)]"/>
                <filter string="Non Certifiées FNE" name="fne_not_certified"
                        domain="[('fne_certified', '=', False), ('move_type', '=', 'out_invoice')]"/>
                <filter string="Alerte Stickers" name="fne_warning"
                        domain="[('fne_warning', '=', True)]"/>
            </filter>

            <!-- Ajout groupe par certification -->
            <group expand="0" position="inside">
                <filter string="Certification FNE" name="group_fne_certified"
                        context="{'group_by': 'fne_certified'}"/>
                <filter string="Template FNE" name="group_fne_template"
                        context="{'group_by': 'fne_template'}"/>
            </group>

        </field>
    </record>

    <!-- =================================================================== -->
    <!-- 5. ACTIONS DE MENU -->
    <!-- =================================================================== -->

    <!-- Menu pour accéder aux factures FNE -->
    <menuitem id="menu_fne_invoices"
              name="Factures FNE"
              parent="account.menu_finance_entries"
              action="account.action_move_out_invoice_type"
              sequence="15"/>

    <!-- Action pour les factures certifiées FNE -->
    <record id="action_move_fne_certified" model="ir.actions.act_window">
        <field name="name">Factures Certifiées FNE</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('fne_certified', '=', True), ('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune facture certifiée FNE trouvée !
            </p>
            <p>
                Les factures certifiées auprès de la FNE apparaîtront ici.
            </p>
        </field>
    </record>

</odoo>
