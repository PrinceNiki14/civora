<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_cotisation_emp_wizard_from_view" model="ir.ui.view">
            <field name="name">hr.cotisation.emp.form</field>
            <field name="model">hr.cotisation.emp</field>
            <field name="arch" type="xml">
                <form string="Rapport Cotisation Employé/Employeur">
                    <group>
                        <group>
                            <field name="lot_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="salary_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Imprimer" name="print_cotisation_emp" type="object" class="btn-primary" icon="fa-download"/>
                        <button string="Annuler" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cotisation_emp_wizard" model="ir.actions.act_window">
            <field name="name">Rapport de cotisation Employé/Employeur</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.cotisation.emp</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="hr_cotisation_emp_book_wizard_menu"
                  name="Rapport de cotisation Employé/Employeur"
                  sequence="5"
                  parent="hr_payroll.menu_hr_payroll_report"
                  action="action_cotisation_emp_wizard"/>

    </data>
</odoo>