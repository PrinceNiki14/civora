<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_cgrae_from_view" model="ir.ui.view">
            <field name="name">hr.cgrae.form</field>
            <field name="model">hr.cgrae</field>
            <field name="arch" type="xml">
                <form string="Rapport CGRAE">
                    <group>
                        <group>
                            <field name="lot_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Imprimer" name="print_cgrae" type="object" class="btn-primary" icon="fa-download"/>
                        <button string="Annuler" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_cgrae_wizard" model="ir.actions.act_window">
            <field name="name">Rapport de cotisation de la CGRAE</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.cgrae</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="hr_cgrae_book_menu"
                  name="Rapport CGRAE"
                  sequence="5"
                  parent="hr_payroll.menu_hr_payroll_report"
                  action="action_hr_cgrae_wizard"/>

    </data>
</odoo>