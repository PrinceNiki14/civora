<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="hr_employee_hr_allocation_form_view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='hr_settings']" position="after">
                    <page string="Paramètres Congés" groups="hr.group_hr_manager">
                        <group>
                            <group string="Date de rétour congé récent">
                                <label for="date_retour_conge"/>
                                <div>
                                    <field name="date_retour_conge" class="oe_inline" readonly="1"/>
                                </div>
                            </group>
                        </group>
                        <separator string="Historique des allocations"/>
                        <field name="historique_allocation_line_ids" nolabel="1" readonly="0">
                            <list editable="bottom">
                                <field name='payroll_date' readonly="1"/>
                                <field name='request_date_from' readonly="1"/>
                                <field name='request_date_to' readonly="1"/>
                                <field name='date_retour_conge' readonly="1"/>
                                <field name='number_of_days_display' readonly="1"/>
                                <field name='nombre_mois_smj' readonly="1"/>
                                <field name='smj' readonly="1"/>
                                <field name='allocation_conge' readonly="1"/>
                                <field name='leave_id' invisible="1" readonly="1"/>
                                <field name='employee_id' invisible="1" readonly="1"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>