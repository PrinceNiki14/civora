<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_employee_cmu_form" model="ir.ui.view">
			<field name="name">hr.hr.employee.view.form</field>
			<field name="model">hr.employee</field>
			<field name="inherit_id" ref="hr.view_employee_form"/>
			<field name="arch" type="xml">
				<data>
				   <xpath expr="//group[@name='emergency']" position="before">
					   <group string="Cotisation CMU">
						   <field name="pay_for_children" invisible="children == 0"/>
							<field name="pay_for_women" invisible="marital != 'married'"/>
							<field name="cmu_part" />
					   </group>
				   </xpath>
				</data>
			</field>
		</record>
    </data>
</odoo>